<mxCell id="fig1_c11" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=21;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="NIC (libibverbs / verbs)&lt;br&gt;EFA など verbs が動く NIC"><mxGeometry x="830" y="592" width="480" height="96" as="geometry"/></mxCell>
