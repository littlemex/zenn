<mxCell id="fig1_c2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB300;strokeColor=#FFB300;fontColor=#3E2723;fontSize=23;fontStyle=1;arcSize=8;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="DeepEP: 真の GPU-initiated (IBGDA)"><mxGeometry x="90" y="92" width="600" height="48" as="geometry"/></mxCell>
