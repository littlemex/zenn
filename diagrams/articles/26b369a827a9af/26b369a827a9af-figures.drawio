<mxCell id="fig1_c15" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#14442F;fontSize=17;fontStyle=0;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="データ本体は FIFO を通らず、GPU メモリから NIC が直接 RDMA (FIFO は小さなコマンドのみ)"><mxGeometry x="830" y="712" width="480" height="58" as="geometry"/></mxCell>
<mxCell id="fig1_c16" parent="1" vertex="1" style="text;html=1;fontSize=21;fontStyle=0;fontColor=#14442F;align=center;verticalAlign=middle;whiteSpace=wrap;" value="同じ「GPU 起点」でも、左は GPU が NIC を直接叩くので ConnectX 系専用。右は GPU はコマンドを積むだけで、CPU が移植性の高い verbs で NIC を叩くため EFA でも動く。"><mxGeometry x="90" y="800" width="1300" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
