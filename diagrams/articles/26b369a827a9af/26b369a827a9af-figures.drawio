<mxCell id="fig4_c3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=21;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="dispatch BF16 (EFA): 41.3〜42.9 GB/s (±2%)"><mxGeometry x="120" y="168" width="540" height="74" as="geometry"/></mxCell>
<mxCell id="fig4_c4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=20;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="dispatch FP8 (EFA): 38.9〜39.2 GB/s"><mxGeometry x="120" y="252" width="540" height="64" as="geometry"/></mxCell>
<mxCell id="fig4_c5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=20;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="combine BF16 (EFA): 17.3〜18.7 GB/s (±5%)"><mxGeometry x="120" y="326" width="540" height="64" as="geometry"/></mxCell>
<mxCell id="fig4_c6" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#14442F;fontSize=18;fontStyle=0;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="per-GPU EFA ≒ 50 GB/s に対し、&lt;br&gt;dispatch はラインレートの 8 割超。&lt;br&gt;一方 combine は 4 割弱で、&lt;br&gt;「送りは速いが戻しは半分以下」の非対称。"><mxGeometry x="120" y="402" width="540" height="118" as="geometry"/></mxCell>
<mxCell id="fig4_c7" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=22;fontStyle=1;arcSize=8;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="low-latency モード"><mxGeometry x="770" y="92" width="600" height="48" as="geometry"/></mxCell>
<mxCell id="fig4_c8" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=21;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="end-to-end: 16.5〜17.0 GB/s (±1.4%)&lt;br&gt;← 代表値はこれだけ"><mxGeometry x="800" y="168" width="540" height="90" as="geometry"/></mxCell>
<mxCell id="fig4_c9" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontColor=#3E2723;fontSize=18;fontStyle=1;arcSize=12;align=left;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="dispatch 単体 / combine 単体は&lt;br&gt;run 間で逆相関に振れる:&lt;br&gt;&lt;br&gt;  dispatch 低 (7.6) ⇔ combine 高 (57.6*)&lt;br&gt;  dispatch 高 (19.2) ⇔ combine 低 (32.0)&lt;br&gt;&lt;br&gt;* 57.6 はラインレート超 = 区分の破綻。&lt;br&gt;カーネルが 2 フェーズを重ねるため&lt;br&gt;単体値は代表値でない"><mxGeometry x="800" y="274" width="540" height="246" as="geometry"/></mxCell>
<mxCell id="fig4_c10" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=22;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="結論: nvidia_peermem 無しの EFA で token 単位の dispatch/combine が正しく完走"><mxGeometry x="120" y="548" width="1220" height="66" as="geometry"/></mxCell>
<mxCell id="fig4_c11" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#14442F;fontSize=19;fontStyle=0;arcSize=12;align=left;verticalAlign=middle;shadow=1;spacingLeft=8;spacingRight=8;" value="比較ではない: DeepEP は EFA で動かず同一ハード上に比較対象がない。UCCL 公式ブログの EP32 (dispatch 54 / combine 43 GB/s) とは EP 規模が違うため直接比較しない。示したいのは「EFA でこのオーダーの帯域が実際に出た」という規模感。"><mxGeometry x="120" y="636" width="1220" height="110" as="geometry"/></mxCell>
<mxCell id="fig4_c12" parent="1" vertex="1" style="text;html=1;fontSize=17;fontStyle=2;fontColor=#1B5E20;align=center;verticalAlign=middle;whiteSpace=wrap;" value="測定: 2026-07-28 に 3 回 + 2026-07-20 に 1 回。生ログと summary.json は distributed-ai リポジトリの 2026-07-20-uccl-ep-efa-p5en/results/ に収録。"><mxGeometry x="120" y="762" width="1220" height="90" as="geometry"/></mxCell>
