        <mxCell id="l17" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#8FA79B;endArrow=none;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="212" y="300" as="sourcePoint"/><mxPoint x="103.36805111193112" y="253.9228941796472" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l18" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#8FA79B;endArrow=none;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="212" y="300" as="sourcePoint"/><mxPoint x="96.09010441401475" y="277.88900487888446" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c19" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D6A4F;strokeColor=#2D6A4F;fontSize=22;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="203" y="291" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c20" value="n_vocab &amp;gt; d_model 本のベクトルは&lt;br&gt;残差ストリーム全体を張ってしまう。&lt;br&gt;「張る部分空間」では空間全体になり無意味" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=1;fontSize=14;fontColor=#B26B4A;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="328" width="308" height="84" as="geometry"/></mxCell>
        <mxCell id="c21" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="408" y="128" width="428" height="296" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;スパース度 k を課すと錐の和集合になる&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="408" y="138" width="428" height="26" as="geometry"/></mxCell>
        <mxCell id="pie0" value="" style="shape=mxgraph.basic.pie;startAngle=0.028;endAngle=0.138;html=1;fillColor=#95D5B2;strokeColor=#2D6A4F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="374" y="160" width="256" height="256" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;S₁&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#2D6A4F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="525.1880931777566" y="192.8710631856995" width="48" height="26" as="geometry"/></mxCell>
        <mxCell id="pie1" value="" style="shape=mxgraph.basic.pie;startAngle=0.139;endAngle=0.249;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="374" y="160" width="256" height="256" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;S₂&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#2D6A4F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="566.9168709969749" y="242.35542231690977" width="48" height="26" as="geometry"/></mxCell>
        <mxCell id="pie2" value="" style="shape=mxgraph.basic.pie;startAngle=0.251;endAngle=0.361;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="374" y="160" width="256" height="256" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;S₃&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#2D6A4F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="566.9168709969749" y="307.64457768309023" width="48" height="26" as="geometry"/></mxCell>
        <mxCell id="c26" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D6A4F;strokeColor=#2D6A4F;fontSize=22;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="492" y="278" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B26B4A;strokeColor=#B26B4A;fontSize=22;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="742" y="168" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;x&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontColor=#B26B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="762" y="156" width="40" height="24" as="geometry"/></mxCell>
        <mxCell id="l29" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#B26B4A;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="744" y="182" as="sourcePoint"/><mxPoint x="652" y="232" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c30" value="&lt;b&gt;Π_S x&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#2D6A4F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="636" y="236" width="116" height="22" as="geometry"/></mxCell>
        <mxCell id="c31" value="k 本ずつ選んだ錐が C(n, k) 個あり、その合併が J-space" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="424" y="374" width="396" height="36" as="geometry"/></mxCell>
        <mxCell id="c32" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="862" y="128" width="296" height="296" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;2 つの成分に割れる&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="862" y="138" width="296" height="26" as="geometry"/></mxCell>
        <mxCell id="c34" value="J-space 成分 Π_S x" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#52B788;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="886" y="180" width="248" height="44" as="geometry"/></mxCell>
        <mxCell id="c35" value="概念ベクトルの分散の 6-7%" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="886" y="226" width="248" height="22" as="geometry"/></mxCell>
        <mxCell id="c36" value="非 J-space 成分 x − Π_S x" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="886" y="256" width="248" height="44" as="geometry"/></mxCell>
        <mxCell id="c37" value="残る約 93%" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="886" y="302" width="248" height="22" as="geometry"/></mxCell>
        <mxCell id="c38" value="因果を担うのは&lt;br&gt;&lt;b&gt;上の小さい方&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#40916C;strokeWidth=1;fontSize=16;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="886" y="334" width="248" height="76" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;形式的な定義 (付録 A.8)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1B4332;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="444" width="1116" height="26" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b&gt;集合&lt;/b&gt;&lt;br&gt;&lt;br&gt;F = ∪ span{ v_i : i ∈ S }, |S| = k" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="42" y="476" width="272" height="90" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;b&gt;距離関数&lt;/b&gt;&lt;br&gt;&lt;br&gt;d_F(x) = min_S ‖ x − Π_S x ‖" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="321" y="476" width="272" height="90" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;b&gt;2 空間の距離&lt;/b&gt;&lt;br&gt;&lt;br&gt;Δ(F, G) = ( E[ (d_F − d_G)² ] )^(1/2)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#95D5B2;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="600" y="476" width="272" height="90" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;片側 (包含)&lt;/b&gt;&lt;br&gt;&lt;br&gt;D(F → G) = ‖ (d_G − d_F) の正部分 ‖" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="879" y="476" width="272" height="90" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;b&gt;3 つの統計的な注意&lt;/b&gt;&lt;br&gt;(1) Δ は擬距離である。データ分布 μ の台の外での違いは見えない。&lt;br&gt;(2) d_F の最小化は組合せ問題であり、実際は gradient pursuit の貪欲解を使う。報告される J-space 成分は真の最近点ではなく、距離としては上からの評価である。&lt;br&gt;(3) k の決め方は因子数の決定と同じ問題であり、occupancy の定義は並行分析と同型である。&lt;br&gt;なお付録の式は span と書いているが本文は非負結合と述べており、幾何は錐の和集合で読むのが正しい。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=2;fontSize=16;fontColor=#B26B4A;verticalAlign=middle;align=left;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="584" width="1116" height="128" as="geometry"/></mxCell>
        <mxCell id="c45" value="偏りの向きに注目したい。貪欲解は真の最近点より遠いので、J-space 成分の因果効果は過小評価されている。つまり論文の数字は主張に不利な側に寄っており、結論の頑健性という点では安心できる。" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="722" width="1116" height="46" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
