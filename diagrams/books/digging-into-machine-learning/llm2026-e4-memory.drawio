d="d39" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="544" y="308" width="30" height="18" as="geometry"/></mxCell><mxCell id="d40" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="580" y="308" width="30" height="18" as="geometry"/></mxCell><mxCell id="d41" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="616" y="308" width="30" height="18" as="geometry"/></mxCell><mxCell id="d42" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="652" y="308" width="30" height="18" as="geometry"/></mxCell><mxCell id="d43" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="688" y="308" width="30" height="18" as="geometry"/></mxCell><mxCell id="d44" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="724" y="308" width="30" height="18" as="geometry"/></mxCell><mxCell id="d45" value="S kⱼ = vⱼ + Σ_{i≠j} (kᵢᵀkⱼ) vᵢ" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="300" height="24" as="geometry"/></mxCell><mxCell id="d46" value="干渉項" style="rounded=1;fillColor=#F6E7E7;strokeColor=#B44;fontColor=#B44;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="930" y="220" width="90" height="30" as="geometry"/></mxCell><mxCell id="d47" style="endArrow=classic;strokeColor=#B44;strokeWidth=2;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="230" as="sourcePoint"/><mxPoint x="870" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d48" value="N ≤ d_k なら {kᵢ} を正規直交に取れて干渉項=0 (厳密復元)。N &gt; d_k で干渉項が漏れ、遠い過去が上書き・混線する。" style="text;html=1;fontSize=11;fontColor=#3A6B4A;align=left;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="260" width="300" height="80" as="geometry"/></mxCell><mxCell id="d49" style="endArrow=none;strokeColor=#9CC7AC;strokeWidth=1;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="150" as="sourcePoint"/><mxPoint x="480" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="d50" value="含意: 純粋な線形モデルは needle-in-a-haystack / RULER で劣化しやすい。だから状態固定の安さと厳密参照を両取りするハイブリッド (3対1 など) に落ち着く。混合比は理論でなくアブレーションの産物。" style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="1020" height="40" as="geometry"/></mxCell></root></mxGraphModel>