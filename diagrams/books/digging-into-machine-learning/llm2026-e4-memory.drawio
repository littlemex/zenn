<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d2" value="固定状態は有限容量の連想記憶: N ≤ d_k で厳密復元が頭打ち" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1020" height="30" as="geometry"/></mxCell><mxCell id="d3" value="左=全結合 Attention の KV-Cache は追記型の台帳で、系列長 L に比例して伸びる (どれだけ長くても厳密参照できる)。右=線形 Attention の状態は d_k×d_v 固定のホワイトボード。書き込むペア数 N が d_k を超えると干渉項が漏れ出す。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="40" as="geometry"/></mxCell><mxCell id="d4" value="全結合 Attention: 追記型の台帳" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#14532D;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="146" width="400" height="24" as="geometry"/></mxCell><mxCell id="d5" value="(k_1, v_1)" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="180" height="32" as="geometry"/></mxCell><mxCell id="d6" value="(k_2, v_2)" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="222" width="180" height="32" as="geometry"/></mxCell><mxCell id="d7" value="(k_3, v_3)" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="264" width="180" height="32" as="geometry"/></mxCell><mxCell id="d8" value="(k_4, v_4)" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="306" width="180" height="32" as="geometry"/></mxCell><mxCell id="d9" value="(k_5, v_5)" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="348" width="180" height="32" as="geometry"/></mxCell><mxCell id="d10" value="(k_6, v_6)" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="180" height="32" as="geometry"/></mxCell><mxCell id="d11" value="⋮ L に比例して無限に伸びる" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#3A6B4A;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="432" width="220" height="20" as="geometry"/></mxCell><mxCell id="d12" value="→ どのペアも厳密参照可 (メモリは O(L))" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#3A6B4A;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="458" width="300" height="18" as="geometry"/></mxCell><mxCell id="d13" value="線形 Attention: 容量固定のホワイトボード" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#14532D;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="146" width="480" height="24" as="geometry"/></mxCell><mxCell id="d14" value="S = Σ vᵢ kᵢᵀ  (d_k × d_v 固定)" style="rounded=1;fillColor=#F5FBF7;strokeColor=#1E7A45;strokeWidth=2;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=top;html=1;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="260" height="190" as="geometry"/></mxCell><mxCell id="d15" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="544" y="220" width="30" height="18" as="geometry"/></mxCell><mxCell id="d16" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="580" y="220" width="30" heigh