    <mxCell id="p4t" value="2 つの直感: 符号だけで内積が復元でき、角度は高次元で集中する" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1B4332;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="40" y="18" width="1040" height="38" as="geometry" />
    </mxCell>
    <mxCell id="qbox" value="&lt;b&gt;QJL: なぜ符号 1 ビットで内積が不偏推定できるか&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2D6A4F;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=top;align=center;spacingTop=10;arcSize=6;" vertex="1" parent="1">
