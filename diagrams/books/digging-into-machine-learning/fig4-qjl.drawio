<mxfile host="app.diagrams.net"><diagram id="bafdhf53-a03j" name="QJLと角度集中"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="640" math="0" shadow="0">
  <root>
    <mxCell id="0" />
