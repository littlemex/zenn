<mxfile host="app.diagrams.net">
  <diagram id="jspace-overview" name="全体像">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="604" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;J-space 論文を貫く一本の背骨&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=27;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="平均勾配で読み、錐の和集合として定義し、分散と因果の乖離に賭け、構造の 3 署名で裏を取り、読む道具と書く道具に変える" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;読む&lt;/b&gt;&lt;br&gt;&lt;br&gt;平均 Jacobian&lt;br&gt;&lt;br&gt;J = E[∂h_final / ∂h_ℓ]&lt;br&gt;logit lens は J = I&lt;br&gt;tuned lens は回帰" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="42" y="148" width="200" height="216" as="geometry"/></mxCell>
        <mxCell id="c4" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#52B788;fontSize=24;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="114" y="112" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;定義する&lt;/b&gt;&lt;br&gt;&lt;br&gt;J-space は部分空間でない&lt;br&gt;&lt;br&gt;スパース部分フレームが&lt;br&gt;張る錐の和集合&lt;br&gt;距離関数で扱う" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="275" y="148" width="200" height="216" as="geometry"/></mxCell>
        <mxCell id="c6" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#52B788;fontSize=24;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="347" y="112" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;賭ける&lt;/b&gt;&lt;br&gt;&lt;br&gt;分散と因果の乖離&lt;br&gt;&lt;br&gt;分散 6-7% の成分が&lt;br&gt;因果の 6 割を担う&lt;br&gt;非 J 成分は 5%" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#95D5B2;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="508" y="148" width="200" height="216" as="geometry"/></mxCell>
        <mxCell id="c8" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#52B788;fontSize=24;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="580" y="112" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;裏を取る&lt;/b&gt;&lt;br&gt;&lt;br&gt;構造の 3 署名&lt;br&gt;&lt;br&gt;層の帯 L38-L92&lt;br&gt;容量 25 概念&lt;br&gt;MLP 増幅 約 10 倍" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#2D6A4F;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="741" y="148" width="200" height="216" as="geometry"/></mxCell>
        <mxCell id="c10" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#52B788;fontSize=24;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="813" y="112" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;道具にする&lt;/b&gt;&lt;br&gt;&lt;br&gt;読む道具と書く道具&lt;br&gt;&lt;br&gt;監査 = 沈黙した意図&lt;br&gt;内省訓練 = 内側に載せる&lt;br&gt;不正直 0.25 → 0.07" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2D6A4F;strokeColor=#2D6A4F;strokeWidth=2;fontSize=15;fontColor=#FFFFFF;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="974" y="148" width="200" height="216" as="geometry"/></mxCell>
        <mxCell id="c12" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#52B788;fontSize=24;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1046" y="112" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#40916C;fontSize=15;fontColor=#1B4332;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#40916C;fontSize=15;fontColor=#1B4332;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#40916C;fontSize=15;fontColor=#1B4332;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#40916C;fontSize=15;fontColor=#1B4332;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;数理統計の言葉に置き換えると&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1B4332;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="392" width="1116" height="26" as="geometry"/></mxCell>
        <mxCell id="c18" value="平均偏微分効果&lt;br&gt;混合効果の固定効果" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="424" width="200" height="62" as="geometry"/></mxCell>
        <mxCell id="c19" value="識別不能とスパース性&lt;br&gt;擬距離と貪欲解" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="275" y="424" width="200" height="62" as="geometry"/></mxCell>
        <mxCell id="c20" value="統制直接効果&lt;br&gt;do(M = m) を実行できる" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#95D5B2;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="508" y="424" width="200" height="62" as="geometry"/></mxCell>
        <mxCell id="c21" value="並行分析と射影追跡&lt;br&gt;幾何を保存する対照" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="741" y="424" width="200" height="62" as="geometry"/></mxCell>
        <mxCell id="c22" value="有病率と適合率&lt;br&gt;因果媒介分析" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="974" y="424" width="200" height="62" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;持ち帰り&lt;/b&gt;: 分散と感度は独立に決まる量である。分散のほとんどを占める成分は行動をほとんど決めておらず、分散の数パーセントの成分が因果のほとんどを担う。論文の貢献は、この当たり前を測定として成立させたことにある。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="526" width="1120" height="54" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
