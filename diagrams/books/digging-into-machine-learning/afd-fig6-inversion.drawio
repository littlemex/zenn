<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="入れ子の向きを反転する: 「P/D が外」か「AFD が外」か" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="左は現状の vLLM 2p1a1f(P/D を外側の主軸にし、decode の内側だけ AFD)。右は AFD を外側の主軸にし、Prefill と Decode の FFN 仕事を 1 つの共有 expert プールに集約する案。FFN は KV を持たないステートレス計算なので、由来フェーズを区別せず束ねられる。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1120" height="34" as="geometry"/></mxCell>

<mxCell id="lt" value="(A) 現状: P/D が外 ・ AFD が内(2p1a1f)" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="lbox" value="" style="rounded=1;fillColor=#F5FBF7;strokeColor=#9CC7AC;strokeWidth=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="126" width="520" height="470" as="geometry"/></mxCell>
<mxCell id="lpf" value="&lt;b&gt;Prefill クラスタ&lt;/b&gt;&#10;attn と FFN を融合(AFD しない)&#10;EP は高スループット型(HT)" style="rounded=1;fillColor=#E8F3EC;strokeColor=#1E7A45;strokeWidth=2;fontColor=#14532D;fontSize=12;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="460" height="80" as="geometry"/></mxCell>
<mxCell id="lkv" style="endArrow=classic;html=1;strokeColor=#1E7A45;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="230" as="sourcePoint"/><mxPoint x="300" y="270" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="lkvl" value="KV-Cache 転送(NIXL)" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1E7A45;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="240" width="200" height="20" as="geometry"/></mxCell>
<mxCell id="lda" value="&lt;b&gt;Decode: Attention プール&lt;/b&gt;&#10;KV 保持・帯域律速&#10;(1a)" style="rounded=1;fillColor=#B7E1C6;strokeColor=#0E3D20;strokeWidth=2;fontColor=#14532D;fontSize=12;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="280" width="220" height="150" as="geometry"/></mxCell>
<mxCell id="ldf" value="&lt;b&gt;Decode: FFN プール&lt;/b&gt;&#10;expert のみ・KV なし&#10;EP は低遅延型(LL)&#10;(1f)" style="rounded=1;fillColor=#8FCBA6;strokeColor=#0E3D20;strokeWidth=2;fontColor=#14532D;fontSize=12;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="280" width="220" height="150" as="geometry"/></mxCell>
<mxCell id="lafd" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#0E3D20;strokeWidth=3;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="355" as="sourcePoint"/><mxPoint x="310" y="355" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="lafdl" value="N2M / M2N(AFD は decode だけに効く)" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#0E3D20;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="436" width="420" height="20" as="geometry"/></mxCell>
<mxCell id="lnote" value="Prefill の FFN は AFD プールに送らずクラスタ内で処理。HT と LL は P/D 分離で別プールに分かれているので衝突しない。" style="text;html=1;fontSize=11;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="460" height="80" as="geometry"/></mxCell>

<mxCell id="rt" value="(B) 反転案: AFD が外 ・ FFN を共有 expert プールに集約" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="96" width="520" height="26" as="geometry"/></mxCell>
<mxCell id="rbox" value="" style="rounded=1;fillColor=#F5FBF7;strokeColor=#9CC7AC;strokeWidth=1;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="126" width="520" height="470" as="geometry"/></mxCell>
<mxCell id="rap" value="&lt;b&gt;Attention サービス&lt;/b&gt;(KV 保持)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="300" height="22" as="geometry"/></mxCell>
<mxCell id="rpa" value="Prefill Attention&#10;演算律速・全系列" style="rounded=1;fillColor=#E8F3EC;strokeColor=#1E7A45;strokeWidth=2;fontColor=#14532D;fontSize=12;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="168" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="rda" value="Decode Attention&#10;帯域律速・KV 読み直し" style="rounded=1;fillColor=#B7E1C6;strokeColor=#0E3D20;strokeWidth=2;fontColor=#14532D;fontSize=12;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="810" y="168" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="rpasep" style="endArrow=none;html=1;strokeColor=#C77D2E;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="168" as="sourcePoint"/><mxPoint x="805" y="258" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="rpasepl" value="フェーズ非対称は消えず Attention の内側に移るだけ(結局 P/D)" style="text;html=1;fontSize=10;fontColor=#B45309;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="310" height="28" as="geometry"/></mxCell>
<mxCell id="rn2m" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#0E3D20;strokeWidth=3;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="360" as="sourcePoint"/><mxPoint x="800" y="330" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="rn2ml" value="N2M / M2N(Prefill も Decode もこの 1 プールへ)" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#0E3D20;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="290" height="28" as="geometry"/></mxCell>
<mxCell id="rshared" value="&lt;b style=&quot;font-size:14px&quot;&gt;共有 FFN / expert プール&lt;/b&gt;&#10;KV なし・ステートレス。Prefill 由来と Decode 由来の token を区別せず束ねられる → expert GEMM のバッチが最大化し利用率が上がる(MegaScale-Infer / Step-3 の方向)" style="rounded=1;fillColor=#8FCBA6;strokeColor=#0E3D20;strokeWidth=2;fontColor=#14532D;fontSize=12;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;spacing=6;" vertex="1" parent="1"><mxGeometry x="650" y="368" width="460" height="90" as="geometry"/></mxCell>
<mxCell id="rconflict" value="&lt;b&gt;しかし通信モードが 1 プールで衝突&lt;/b&gt;: Prefill FFN は HT(normal)、Decode FFN は LL(low_latency)を要求。DeepEP は 1 通信グループで両立不可(バッファ設計由来)。時分割するか、結局フェーズで割り直す=P/D に逆戻り。" style="rounded=1;fillColor=#F5E6D0;strokeColor=#C77D2E;strokeWidth=2;fontColor=#B45309;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="472" width="460" height="108" as="geometry"/></mxCell>

<mxCell id="foot" value="結論: FFN のステートレス性ゆえ「AFD を外・共有 expert プール」は実在する設計方向(研究の主流)。ただし「純 AFD・P/D ゼロ」にはならない。フェーズ非対称が (1) Attention の資源プロファイルと (2) 共有プールの EP 通信モードの両方で必ず顔を出す。両者は排他でなく直交し、どちらの入れ子でも P/D は形を変えて残る。" style="text;html=1;fontSize=12;fontColor=#14532D;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1100" height="60" as="geometry"/></mxCell>
</root></mxGraphModel>
