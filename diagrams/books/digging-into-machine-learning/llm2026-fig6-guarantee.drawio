<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g2" value="品質はどこで守られているか: 定理型はspeculative decodeだけ, 残りは「学習時に制約を焼き込む」共設計型" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1000" height="30" as="geometry"/></mxCell><mxCell id="g3" value="業界は「推論時の厳密アルゴリズムで正しさを保証する」方向(spec decodeのみ)を除き, 「理論保証を手放し, 品質は学習時の共設計と経験則に委ねる」方向へ寄った. 左ほど保証が固く, 右へ行くほど設計者の選択(数値は次のハード世代で動く)." style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1000" height="44" as="geometry"/></mxCell><mxCell id="g4" value="トレンド \ 保証レベル" style="rounded=0;fillColor=#14532D;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="190" height="44" as="geometry"/></mxCell><mxCell id="g5" value="定理で守られる部分" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="270" height="44" as="geometry"/></mxCell><mxCell id="g6" value="経験則(上界+観測)の部分" style="rounded=0;fillColor=#5BA37D;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="270" height="44" as="geometry"/></mxCell><mxCell id="g7" value="コストモデル選択の部分" style="rounded=0;fillColor=#9DBFAC;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="270" height="44" as="geometry"/></mxCell><mxCell id="g8" value="MTP / 投機デコード" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="190" height="118" as="geometry"/></mxCell><mxCell id="g9" value="棄却サンプリングが&lt;br&gt;出力分布を厳密保存.&lt;br&gt;受理率=1-TV(p,q),&lt;br&gt;期待受理長(1-α^{γ+1})/(1-α)" style="rounded=0;fillColor=#1E7A45;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="164" width="270" height="118" as="geometry"/></mxCell><mxCell id="g10" value="受理率αが実際に高い&lt;br&gt;(ドラフトが当たる)ことは&lt;br&gt;モデル依存の観測" style="rounded=0;fillColor=#7FC29B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#0E3D20;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="500" y="164" width="270" height="118" as="geometry"/></mxCell><mxCell id="g11" value="γ(先読み数)と&lt;br&gt;ドラフタ規模はサービング&lt;br&gt;形態で決める" style="rounded=0;fillColor=#E3F1E8;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="164" width="270" height="118" as="geometry"/></mxCell><mxCell id="g12" value="量子化 (低ビット)" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="190" height="118" as="geometry"/></mxCell><mxCell id="g13" value="確率的丸めの不偏性&lt;br&gt;E[Q(x)]=x.&lt;br&gt;PTQの歪みには上界理論" style="rounded=0;fillColor=#1E7A45;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="282" width="270" height="118" as="geometry"/></mxCell><mxCell id="g14" value="QATが平坦解を見つける,&lt;br&gt;int4でも劣化小は観測.&lt;br&gt;STE収束理論は限定的(空白)" style="rounded=0;fillColor=#7FC29B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#0E3D20;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="500" y="282" width="270" height="118" as="geometry"/></mxCell><mxCell id="g15" value="どの層をFP4/FP8に振るか&lt;br&gt;=感度に応じたビット配分&lt;br&gt;(逆注水の運用判断)" style="rounded=0;fillColor=#E3F1E8;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="282" width="270" height="118" as="geometry"/></mxCell><mxCell id="g16" value="Attention 疎化・圧縮" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="190" height="118" as="geometry"/></mxCell><mxCell id="g17" value="落とした重み総和ε なら&lt;br&gt;出力誤差 ≦ ε・max‖v‖.&lt;br&gt;固定状態の検索不可能性" style="rounded=0;fillColor=#1E7A45;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="400" width="270" height="118" as="geometry"/></mxCell><mxCell id="g18" value="attention質量が集中する,&lt;br&gt;実効ランクが低いは観測&lt;br&gt;(H2O/Quest系)" style="rounded=0;fillColor=#7FC29B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#0E3D20;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="500" y="400" width="270" height="118" as="geometry"/></mxCell><mxCell id="g19" value="SWA:Full比 3:1/4:1,&lt;br&gt;圧縮率128倍等は&lt;br&gt;アブレーションの産物" style="rounded=0;fillColor=#E3F1E8;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="400" width="270" height="118" as="geometry"/></mxCell><mxCell id="g20" value="MoE" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="190" height="118" as="geometry"/></mxCell><mxCell id="g21" value="(定理はほぼ無い)&lt;br&gt;負荷分散は最適輸送/&lt;br&gt;割当問題として定式化可" style="rounded=0;fillColor=#EDEDED;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#8A8A8A;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="518" width="270" height="118" as="geometry"/></mxCell><mxCell id="g22" value="知識容量∝総param,&lt;br&gt;演算∝activeのスケール則.&lt;br&gt;約2bit/paramは合成タスク観測" style="rounded=0;fillColor=#7FC29B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#0E3D20;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="500" y="518" width="270" height="118" as="geometry"/></mxCell><mxCell id="g23" value="active比3〜7%への収束は&lt;br&gt;HBM容量とall-to-all帯域の&lt;br&gt;交点(ハード世代依存)" style="rounded=0;fillColor=#E3F1E8;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="770" y="518" width="270" height="118" as="geometry"/></mxCell><mxCell id="g24" value="読み筋: 濃い緑(左列)が「定理で守られる」領域. MTP/投機デコードだけがここに大きく踏み込む. 他の3トレンドは中央(経験則)〜右(コストモデル)に重心があり, 正しさは学習が引き受ける. これが2026年アーキテクチャの本質的な非対称性." style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="652" width="1000" height="52" as="geometry"/></mxCell></root></mxGraphModel>