        <mxCell id="c21" value="特異度 99.9% での A" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#2D6A4F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="144.0" y="377.45" width="240" height="22" as="geometry"/></mxCell>
