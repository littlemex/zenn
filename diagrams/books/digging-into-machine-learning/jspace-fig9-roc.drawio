        <mxCell id="c23" value="&lt;b&gt;特異度 99.9 パーセントに揃えて比べる&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1B4332;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="598" height="26" as="geometry"/></mxCell>
        <mxCell id="c24" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="560" y="178" width="286" height="48" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;曲線 A&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="848" y="178" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;曲線 B&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=2;fontSize=16;fontColor=#B26B4A;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1006" y="178" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b&gt;AUC&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=left;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="560" y="232" width="286" height="48" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;0.853&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="848" y="232" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;0.850&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1006" y="232" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b&gt;特異度 99.9% での感度&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=left;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="560" y="286" width="286" height="48" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;30.4%&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="848" y="286" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;0.4%&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1006" y="286" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;陽性率 0.2% での適合率&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=left;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="286" height="48" as="geometry"/></mxCell>
        <mxCell id="c34" value="&lt;b&gt;37.9%&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="848" y="340" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c35" value="&lt;b&gt;0.8%&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1006" y="340" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;b&gt;陽性 100 件のうち真の陽性&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=left;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="560" y="394" width="286" height="48" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;b&gt;約 38 件&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="848" y="394" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;約 1 件&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1006" y="394" width="152" height="48" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;曲線 B の作り方&lt;/b&gt;&lt;br&gt;(0, 0) → (0.24, 0.94) → (1, 1) の 2 区分線形。AUC は 0.850 で A とほぼ同じだが、原点付近の傾きが有限なので左端では感度がほとんど出ない。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="560" y="452" width="598" height="88" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b&gt;だから AUC だけで監査の実用性を語れない&lt;/b&gt;: 希少事象では、全域の AUC ではなく偽陽性率 10⁻³ 以下に絞った部分 AUC、適合率と再現率の曲線下面積、あるいはレビュー件数を固定したときの再現率が目的に対応する指標になる。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="560" width="1116" height="60" as="geometry"/></mxCell>
        <mxCell id="c41" value="さらに、論文が報告する AUC の正解ラベルは NLA の判定であり、0.2 パーセントもその陽性率である。したがって計算できるのは「NLA 判定を再現する適合率」であって、真の評価認識に対する適合率ではない。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=2;fontSize=15;fontColor=#B26B4A;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="632" width="1116" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
