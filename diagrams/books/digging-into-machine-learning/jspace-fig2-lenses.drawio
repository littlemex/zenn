<mxfile host="app.diagrams.net">
  <diagram id="jspace-lenses" name="3 つの lens">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;3 つの lens は 3 つの別の量を推定している&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=27;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="同じ量の異なる推定量ではなく、異なる推定対象 (estimand) を持つ異なる推定量である" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;logit lens&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;fontSize=24;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="42" y="130" width="358" height="66" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;A = I&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=20;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="208" width="358" height="58" as="geometry"/></mxCell>
        <mxCell id="c5" value="推定対象&lt;br&gt;&lt;b&gt;恒等写像&lt;/b&gt;&lt;br&gt;座標変換は起きていないと仮定" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40916C;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="42" y="278" width="358" height="108" as="geometry"/></mxCell>
        <mxCell id="c6" value="強い: 後段の層では残差接続のおかげで妥当" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="398" width="358" height="56" as="geometry"/></mxCell>
        <mxCell id="c7" value="弱い: 序盤の層で意味の取れない断片を返す" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=1;fontSize=15;fontColor=#B26B4A;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="462" width="358" height="56" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;tuned lens&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=24;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="358" height="66" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;A = argmin 予測誤差&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=20;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="420" y="208" width="358" height="58" as="geometry"/></mxCell>
        <mxCell id="c10" value="推定対象&lt;br&gt;&lt;b&gt;回帰係数&lt;/b&gt;&lt;br&gt;条件付き期待値の最良線形近似 (相関的)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40916C;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="278" width="358" height="108" as="geometry"/></mxCell>
        <mxCell id="c11" value="強い: 次トークン分布の一致度は全層で最良" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="420" y="398" width="358" height="56" as="geometry"/></mxCell>
        <mxCell id="c12" value="弱い: 中間結果を飛ばして答えに先回りする" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=1;fontSize=15;fontColor=#B26B4A;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="420" y="462" width="358" height="56" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;Jacobian lens&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#2D6A4F;strokeWidth=2;fontSize=24;fontColor=#FFFFFF;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="798" y="130" width="358" height="66" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;A = E[∂f / ∂h]&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=20;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="798" y="208" width="358" height="58" as="geometry"/></mxCell>
        <mxCell id="c15" value="推定対象&lt;br&gt;&lt;b&gt;平均偏微分効果&lt;/b&gt;&lt;br&gt;押したとき出力がどう動くか (介入的)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40916C;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="798" y="278" width="358" height="108" as="geometry"/></mxCell>
        <mxCell id="c16" value="強い: 因果効果と中間概念の回収で最良" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="798" y="398" width="358" height="56" as="geometry"/></mxCell>
        <mxCell id="c17" value="弱い: 次トークン一致度は 3 つの中で最下位" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=1;fontSize=15;fontColor=#B26B4A;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="798" y="462" width="358" height="56" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Stein の補題が 2 つを橋渡しする&lt;/b&gt;  &amp;nbsp; E[∇g(x)] = Σ^(-1) E[g(x)(x − μ)] &amp;nbsp;  ガウス入力なら平均勾配と白色化した共分散が厳密に一致する。ゆえに判別方向 (template lens) は J-lens の近似になる。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="536" width="1116" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="ガウス性が破れる分だけ template lens は回帰側に寄り、tuned lens と同じ「答えへの先回り」の病理を継ぐ。予測に最適なモデルと説明に最適なモデルは違う、という統計学の古典的な区別がそのまま現れている。" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="606" width="1116" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
