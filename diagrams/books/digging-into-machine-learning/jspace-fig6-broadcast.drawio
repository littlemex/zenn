        <mxCell id="c23" value="序盤の作業空間層では SAE 上位 κ が J-lens を上回る。著者らはこれを手法の限界の証拠として自ら報告している" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=1;fontSize=13;fontColor=#B26B4A;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="66" y="492" width="506" height="34" as="geometry"/></mxCell>
