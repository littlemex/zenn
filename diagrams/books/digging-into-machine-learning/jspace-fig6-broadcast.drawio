        <mxCell id="c1" value="&lt;b&gt;J-space は深さ方向と系列方向の両方に広く放送されている&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=27;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="対照集団の設計が結論を作っている。ランダム直交回転はスペクトルと相互幾何を保存したまま方向だけを壊す" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;作業空間 (L38-L92) の残差ストリーム&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#2D6A4F;strokeWidth=2;fontSize=19;fontColor=#FFFFFF;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="340" y="132" width="520" height="62" as="geometry"/></mxCell>
