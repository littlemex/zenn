        <mxCell id="c26" value="&lt;b&gt;系列方向: 上位 1% の head が中継する&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontColor=#1B4332;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="676" y="230" width="460" height="36" as="geometry"/></mxCell>
        <mxCell id="c27" value="2 指標の悪い方の順位でスコアする min-max スカラー化で選抜" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="268" width="506" height="22" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;gain&lt;/b&gt;&lt;br&gt;‖ W_OV v ‖ の平均を&lt;br&gt;ランダム方向で正規化" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="630" y="298" width="246" height="96" as="geometry"/></mxCell>
