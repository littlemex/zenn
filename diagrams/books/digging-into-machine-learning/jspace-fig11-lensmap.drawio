<mxfile host="app.diagrams.net">
  <diagram id="jspace-lensmap" name="lens の 2 軸配置">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="748" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;5 つの読み出し手法は性能の序列ではなく、推定対象の族で分かれる&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=27;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="縦軸は勾配を平均する (介入的) か、出力への予測を当てはめる (相関的) か" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;語彙の事前列挙が不要&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="122" width="400.0" height="26" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;語彙を事前に列挙する&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610.0" y="122" width="400.0" height="26" as="geometry"/></mxCell>
        <mxCell id="c5" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="210" y="158" width="800" height="430" as="geometry"/></mxCell>
        <mxCell id="l6" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#CDE9DC;dashed=1;endArrow=none;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="373.0" as="sourcePoint"/><mxPoint x="1010" y="373.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l7" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#CDE9DC;dashed=1;endArrow=none;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="158" as="sourcePoint"/><mxPoint x="610.0" y="588" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c8" value="&lt;b&gt;介入的&lt;/b&gt;&lt;br&gt;勾配を平均する" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#2D6A4F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="34" y="198" width="168" height="64" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;相関的&lt;/b&gt;&lt;br&gt;出力への予測を&lt;br&gt;当てはめる" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#B26B4A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="34" y="476" width="168" height="72" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;J-lens&lt;/b&gt;&lt;br&gt;平均 Jacobian。1 トークン語彙に限られる" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#52B788;strokeColor=#2D6A4F;strokeWidth=2;fontSize=13;fontColor=#FFFFFF;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="246" y="190" width="228" height="80" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;logit lens&lt;/b&gt;&lt;br&gt;J = I。学習しないので軸の外側に近い" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=13;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="246" y="330" width="228" height="80" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;tuned lens&lt;/b&gt;&lt;br&gt;出力分布への KL 射影。答えに先回りする" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;fontSize=13;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="246" y="470" width="228" height="80" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;template lens&lt;/b&gt;&lt;br&gt;白色化平均差。多トークン語に強い" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;fontSize=13;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="742" y="400" width="228" height="80" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;oracle lens&lt;/b&gt;&lt;br&gt;template を任意長の語句へ。要 2 モデル" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#95D5B2;strokeColor=#2D6A4F;strokeWidth=2;fontSize=13;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="742" y="490" width="228" height="80" as="geometry"/></mxCell>
        <mxCell id="l15" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#B26B4A;dashed=1;endArrow=none;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="474" y="510" as="sourcePoint"/><mxPoint x="742" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c16" value="同じ象限にいるので&lt;br&gt;同じ病理が出る" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#B26B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="486" y="528" width="258" height="46" as="geometry"/></mxCell>
        <mxCell id="l17" value="" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#40916C;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="480" as="sourcePoint"/><mxPoint x="856" y="490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;b&gt;この配置が固定すること&lt;/b&gt;: template lens が tuned lens と同じ「答えへの先回り」を示すのは、偶然ではなく同じ象限にいるからである。Stein の補題はガウス性の下で上下の象限を繋ぐが、ガウス性が破れれば同値性は失われる。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="606" width="1116" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="したがって手法を「性能の良し悪し」で並べるのは誤りである。1 トークンの読み出しなら J-lens、多トークンの語や語句なら template lens と oracle lens、という推定対象による使い分けになる。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="678" width="1116" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
