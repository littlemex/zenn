<mxfile host="app.diagrams.net">
  <diagram id="jspace-greedy" name="貪欲解の偏り">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="716" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;貪欲解の偏りは、指標ごとに向きが違う&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=27;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="gradient pursuit は近似解である。何が保守側に寄り、何が寄らないかを取り違えないための整理" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c3" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="130" width="548" height="412" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;台の選択を誤ると別の錐に落ちる&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="142" width="548" height="26" as="geometry"/></mxCell>
        <mxCell id="g0.055" value="" style="shape=mxgraph.basic.pie;startAngle=0.055;endAngle=0.155;html=1;fillColor=#95D5B2;strokeColor=#2D6A4F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;S 真&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#2D6A4F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="237.71012527739822" y="294.5518635520442" width="68" height="26" as="geometry"/></mxCell>
        <mxCell id="g0.245" value="" style="shape=mxgraph.basic.pie;startAngle=0.245;endAngle=0.345;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="300" height="300" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;S 貪欲&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#2D6A4F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="278.35436122420236" y="419.6419594065898" width="68" height="26" as="geometry"/></mxCell>
        <mxCell id="c7" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2D6A4F;strokeColor=#2D6A4F;fontSize=22;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="190" y="390" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="c8" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B26B4A;strokeColor=#B26B4A;fontSize=22;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="392" y="236" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;x&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=19;fontColor=#B26B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="414" y="224" width="40" height="24" as="geometry"/></mxCell>
        <mxCell id="l10" value="" style="edgeStyle=none;html=1;strokeWidth=3;strokeColor=#2D6A4F;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="392" y="250" as="sourcePoint"/><mxPoint x="312" y="296" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c11" value="真の最近点" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#2D6A4F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="150" height="22" as="geometry"/></mxCell>
        <mxCell id="l12" value="" style="edgeStyle=none;html=1;strokeWidth=3;strokeColor=#B26B4A;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="392" y="250" as="sourcePoint"/><mxPoint x="306" y="404" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c13" value="貪欲解 (誤った台)" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#B26B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="404" width="180" height="22" as="geometry"/></mxCell>
        <mxCell id="c14" value="貪欲解が最適解より近くなることはないので、&lt;br&gt;報告される d_F は真の値の &lt;b&gt;上からの評価&lt;/b&gt; になる" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="66" y="462" width="500" height="62" as="geometry"/></mxCell>
        <mxCell id="c15" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="606" y="130" width="552" height="412" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;指標ごとに偏りの向きが違う&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="606" y="142" width="552" height="26" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;再構成距離 d_F&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="630" y="186" width="254" height="84" as="geometry"/></mxCell>
        <mxCell id="c18" value="→" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="216" width="32" height="24" as="geometry"/></mxCell>
        <mxCell id="c19" value="上向きに確定 (真の値以上)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;fontSize=14;fontColor=#2D6A4F;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="926" y="186" width="208" height="84" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;J-space の分散シェア&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="630" y="286" width="254" height="84" as="geometry"/></mxCell>
        <mxCell id="c21" value="→" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="316" width="32" height="24" as="geometry"/></mxCell>
        <mxCell id="c22" value="過小評価しうる (真は 6-7% 以上)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=14;fontColor=#2D6A4F;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="926" y="286" width="208" height="84" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;入れ替えの因果効果&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="630" y="386" width="254" height="84" as="geometry"/></mxCell>
        <mxCell id="c24" value="→" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="416" width="32" height="24" as="geometry"/></mxCell>
        <mxCell id="c25" value="向きは不定 (過大にも過小にも)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=2;fontSize=14;fontColor=#B26B4A;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="926" y="386" width="208" height="84" as="geometry"/></mxCell>
        <mxCell id="c26" value="まとめて「保守的」とは言えない。&lt;b&gt;「真の成分ならもっと効くはず」も言えない&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=1;fontSize=15;fontColor=#B26B4A;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="630" y="480" width="504" height="48" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b&gt;ではどう確かめるか&lt;/b&gt;: 辞書の相互コヒーレンスに対する感度分析と、再標本化のもとで選ばれる台がどれだけ安定するかの測定 (安定性選択) である。台の Jaccard 係数、正則化経路、辞書を摂動させたときの因果効果の変動を見れば、この不定性は定量化できる。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="562" width="1116" height="66" as="geometry"/></mxCell>
        <mxCell id="c28" value="同じ注意は k の選び方にも及ぶ。k = 25 は語彙のコヒーレンスが高い辞書では台の一意回復が保証される範囲を超えている。読み出しの上位語を 1 語ずつ「モデルが考えていた語」と読むのは、この保証の外にある行為である。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=15;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="640" width="1116" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
