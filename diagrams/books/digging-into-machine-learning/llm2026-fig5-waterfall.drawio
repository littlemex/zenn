<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="w2" value="バイト/トークン ウォーターフォール: 4トレンドは「同じ式」の別因子を削っている" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1000" height="30" as="geometry"/></mxCell><mxCell id="w3" value="decode 1トークンの時間 ≈ ( P_active・b_weight + L_eff・d_KV・b_KV ) / 帯域 ÷ τ.  縦軸=1トークンあたり実効メモリ読み出し量(対数, dense 1T FP16=1.0). 各トレンドが別々の因子を叩き, 積で約2〜3桁削減." style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="40" as="geometry"/></mxCell><mxCell id="w4" value="" style="rounded=0;fillColor=#14532D;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="130" width="130" height="430" as="geometry"/></mxCell><mxCell id="w5" value="1.0" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="130" y="106" width="130" height="18" as="geometry"/></mxCell><mxCell id="w6" value="dense 1T&lt;br&gt;FP16" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130" y="136" width="130" height="70" as="geometry"/></mxCell><mxCell id="w7" value="起点: 全パラメータを&lt;br&gt;FP16で毎トークン読む" style="text;html=1;fontSize=10;fontColor=#3A6B4A;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="122" y="568" width="146" height="56" as="geometry"/></mxCell><mxCell id="w8" value="" style="rounded=0;fillColor=#1E7A45;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="316" width="130" height="244" as="geometry"/></mxCell><mxCell id="w9" value="0.05" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="292" width="130" height="18" as="geometry"/></mxCell><mxCell id="w10" value="MoE化&lt;br&gt;(active 5%)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="322" width="130" height="70" as="geometry"/></mxCell><mxCell id="w11" value="条件付き計算&lt;br&gt;P_active を 1/20 に&lt;br&gt;(容量は増大・帯域は減)" style="text;html=1;fontSize=10;fontColor=#3A6B4A;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="292" y="568" width="146" height="56" as="geometry"/></mxCell><mxCell id="w12" style="endArrow=none;strokeColor=#B98C6A;strokeWidth=1.5;dashed=1;dashPattern=4 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="130" as="sourcePoint"/><mxPoint x="300" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="w13" style="endArrow=classic;strokeColor=#B98C6A;strokeWidth=1.5;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="130" as="sourcePoint"/><mxPoint x="300" y="316" as="targetPoint"/></mxGeometry></mxCell><mxCell id="w14" value="" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="396" width="130" height="164" as="geometry"/></mxCell><mxCell id="w15" value="0.014" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="372" width="130" height="18" as="geometry"/></mxCell><mxCell id="w16" value="低ビット&lt;br&gt;(FP4/8)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="402" width="130" height="70" as="geometry"/></mxCell><mxCell id="w17" value="b_weight を&lt;br&gt;FP16→平均4-8bit&lt;br&gt;≈ 0.28倍" style="text;html=1;fontSize=10;fontCol