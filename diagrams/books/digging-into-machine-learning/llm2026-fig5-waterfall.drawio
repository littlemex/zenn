ometry relative="1" as="geometry"><mxPoint x="640" y="396" as="sourcePoint"/><mxPoint x="640" y="433" as="targetPoint"/></mxGeometry></mxCell><mxCell id="w26" value="" style="rounded=0;fillColor=#8FCBA6;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="810" y="495" width="130" height="65" as="geometry"/></mxCell><mxCell id="w27" value="0.00285" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="810" y="471" width="130" height="18" as="geometry"/></mxCell><mxCell id="w28" value="÷τ&lt;br&gt;(MTP/投機)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="810" y="501" width="130" height="59" as="geometry"/></mxCell><mxCell id="w29" value="期待受理長 τ≈2.7&lt;br&gt;1 forwardで複数トークン&lt;br&gt;(分布は厳密保存)" style="text;html=1;fontSize=10;fontColor=#3A6B4A;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="802" y="568" width="146" height="56" as="geometry"/></mxCell><mxCell id="w30" style="endArrow=none;strokeColor=#B98C6A;strokeWidth=1.5;dashed=1;dashPattern=4 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="433" as="sourcePoint"/><mxPoint x="810" y="433" as="targetPoint"/></mxGeometry></mxCell><mxCell id="w31" style="endArrow=classic;strokeColor=#B98C6A;strokeWidth=1.5;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="433" as="sourcePoint"/><mxPoint x="810" y="495" as="targetPoint"/></mxGeometry></mxCell><mxCell id="w32" style="endArrow=none;strokeColor=#14532D;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="560" as="sourcePoint"/><mxPoint x="960" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="w33" value="合計 ≈ 351分の1&lt;br&gt;(約 2.5 桁)" style="rounded=1;fillColor=#E8F3EC;strokeColor=#2E9E5B;strokeWidth=2;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="485" width="150" height="60" as="geometry"/></mxCell><mxCell id="w34" value="注: 削減率は各技術の代表オーダーを掛けた概念的試算(公称スペックの積であり特定モデルの実測ではない). MoEは帯域を下げるが総容量とall-to-all通信は増大. τ(期待受理長)倍速はdecodeがmemory-boundである前提でのみ成立." style="text;html=1;fontSize=10;fontStyle=2;fontColor=#7A9A85;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1020" height="40" as="geometry"/></mxCell></root></mxGraphModel>