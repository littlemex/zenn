<mxfile host="app.diagrams.net">
  <diagram id="jspace-ppv" name="有病率と適合率">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;AUC は有病率に不変だが、適合率は不変でない&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=27;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="評価認識プローブの AUC 0.853 を、陽性率 0.2% の母集団に当てたときに何が起きるか" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Bayes の定理&lt;/b&gt; &amp;nbsp;&amp;nbsp; 適合率 = π · 感度 / ( π · 感度 + (1 − π) · (1 − 特異度) ) &amp;nbsp;&amp;nbsp; ここで π は陽性率。NLA パイプラインが約 94,000 位置のうち 198 位置 (0.2%) を潜在的に評価認識ありと判定した。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="124" width="1116" height="74" as="geometry"/></mxCell>
        <mxCell id="c4" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="218" width="272" height="300" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;感度重視&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;fontSize=18;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="232" width="240" height="44" as="geometry"/></mxCell>
        <mxCell id="c6" value="感度 0.80 ・ 特異度 0.80" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="286" width="240" height="26" as="geometry"/></mxCell>
        <mxCell id="c7" value="陽性的中率" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="318" width="240" height="26" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;0.8%&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=34;fontColor=#2D6A4F;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="342" width="240" height="52" as="geometry"/></mxCell>
        <mxCell id="c9" value="陽性 100 件のうち真の陽性" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="398" width="240" height="24" as="geometry"/></mxCell>
