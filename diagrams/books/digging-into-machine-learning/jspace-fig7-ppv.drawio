        <mxCell id="c423" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDE9DC;strokeColor=#CDE9DC;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1127" y="428" width="9" height="9" as="geometry"/></mxCell>
        <mxCell id="c424" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDE9DC;strokeColor=#CDE9DC;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1127" y="440" width="9" height="9" as="geometry"/></mxCell>
        <mxCell id="c425" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDE9DC;strokeColor=#CDE9DC;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1127" y="452" width="9" height="9" as="geometry"/></mxCell>
        <mxCell id="c426" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDE9DC;strokeColor=#CDE9DC;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1127" y="464" width="9" height="9" as="geometry"/></mxCell>
        <mxCell id="c427" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDE9DC;strokeColor=#CDE9DC;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1127" y="476" width="9" height="9" as="geometry"/></mxCell>
        <mxCell id="c428" value="&lt;b&gt;読み取れること&lt;/b&gt;: 陽性率 0.2% の世界では、適合率を 3 割にするだけで特異度 99.9% が必要になり、その代償として感度が 2 割に落ちる。AUC 0.853 は分類器として悪くないが、希少事象の探索では人間のレビューに回す候補の大半が誤検出になる。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=2;fontSize=17;fontColor=#B26B4A;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="536" width="1116" height="68" as="geometry"/></mxCell>
        <mxCell id="c429" value="&lt;b&gt;だから 2 段構成が必須になる&lt;/b&gt;: 第 1 段の J-lens スコアで感度を稼ぎ、第 2 段の LLM 判定で特異度を稼ぐ。論文が「概念実証としてのみこの単純な分類器を使う」と明記しているのは、この算術の帰結である。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="614" width="1116" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
