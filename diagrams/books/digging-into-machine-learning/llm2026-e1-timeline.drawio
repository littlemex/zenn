<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a2" value="投機デコード: ドラフトが先読み、本体が1パスで並列検証" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1020" height="30" as="geometry"/></mxCell><mxCell id="a3" value="上段=素の自己回帰 (1トークンごとに本体を4回起動)。下段=投機デコード (小さいドラフトがγ=4個提案し、本体は1回の検証パスで並列確認)。✓は受理、✗で打ち切って残差から再サンプル、全受理なら末尾にボーナス1個。受理長ぶんをまとめて確定する。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="40" as="geometry"/></mxCell><mxCell id="a4" value="素の自己回帰" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#8A8A8A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="126" width="160" height="24" as="geometry"/></mxCell><mxCell id="a5" value="本体 forward 1" style="rounded=1;fillColor=#D9D9D9;strokeColor=#9A9A9A;fontColor=#8A8A8A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="210" y="130" width="150" height="42" as="geometry"/></mxCell><mxCell id="a6" value="本体 forward 2" style="rounded=1;fillColor=#D9D9D9;strokeColor=#9A9A9A;fontColor=#8A8A8A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="372" y="130" width="150" height="42" as="geometry"/></mxCell><mxCell id="a7" value="本体 forward 3" style="rounded=1;fillColor=#D9D9D9;strokeColor=#9A9A9A;fontColor=#8A8A8A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="534" y="130" width="150" height="42" as="geometry"/></mxCell><mxCell id="a8" value="本体 forward 4" style="rounded=1;fillColor=#D9D9D9;strokeColor=#9A9A9A;fontColor=#8A8A8A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="696" y="130" width="150" height="42" as="geometry"/></mxCell><mxCell id="a9" value="重い順伝播×4 = 巨大な重みを4回読み直す (帯域律速)" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#8A8A8A;align=left;" vertex="1" parent="1"><mxGeometry x="210" y="176" width="640" height="18" as="geometry"/></mxCell><mxCell id="a10" value="投機デコードは γ 個のドラフトを本体1回でまとめて検証する。受理 ✓✓✓ の3トークンを確定 → ✗ で打ち切り、残差 (p−q)+ から1個再サンプル。この検証1回で 3+1=4 トークン前進。" style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="210" y="220" width="660" height="44" as="geometry"/></mxCell><mxCell id="a11" value="投機デコード" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="160" height="24" as="geometry"/></mxCell><mxCell id="a12" value="draft1" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="210" y="380" width="70" height="34" as="geometry"/></mxCell><mxCell id="a13" value="draft2" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="288" y="380" width="70" height="34" as="geometry"/></mxCell><mxCell id="a14" value="draft3" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="366" y="380" width="70" height="34" as="geometry"/></mxCell><mxCell id="a15" value="draft4" style="rounded=1;fillColor=#B7E1C6;strokeColor=#2E9E5B;fontColor=#14532D;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="444" y="380" width="70" height="34" as="geometry"/></mxCell><mxCell id="a16" value="ドラフトが γ=4 個を軽量に逐次生成" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#3A6B4A;align=left;" vertex="1" parent="1"><mxGeometry x="210" y="418" width="340" height="16" as="geometry"/></mxCell><mxCell id="a17" value="本体 検証 forward ×1" style="rounded=1;fillColor=#1E7A45;strokeColor=#14532D;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="374" width="200" height="46" as="geometry"/></mxCell><mxCell id="a18" value="γ+1 トークンを1パスで並列検証" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#3A6B4A;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="422" width="200" height="16" as="geometry"/></mxCell><mxCell id="a19" value="✓" style="rounded=1;fillColor=#5BB97E;strokeColor=#14532D;fontColor=#14532D;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="229" y="320" width="32" height="32" as="geometry"/></mxCell><mxCell id="a20" style="endArrow=none;strokeColor=#14532D;strokeWidth=1.5;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="352" as="sourcePoint"/><mxPoint x="245" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a21" value="✓" style="rounded=1;fillColor=#5BB97E;strokeColor=#14532D;fontColor=#14532D;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="307" y="320" width="32" height="32" as="geometry"/></mxCell><mxCell id="a22" style="endArrow=none;strokeColor=#14532D;strokeWidth=1.5;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="323" y="352" as="sourcePoint"/><mxPoint x="323" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a23" value="✓" style="rounded=1;fillColor=#5BB97E;strokeColor=#14532D;fontColor=#14532D;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="385" y="320" width="32" height="32" as="geometry"/></mxCell><mxCell id="a24" style="endArrow=none;strokeColor=#14532D;strokeWidth=1.5;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="401" y="352" as="sourcePoint"/><mxPoint x="401" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a25" value="✗" style="rounded=1;fillColor=#E9B8B8;strokeColor=#B44;fontColor=#B44;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="463" y="320" width="32" height="32" as="geometry"/></mxCell><mxCell id="a26" style="endArrow=none;strokeColor=#B44;strokeWidth=1.5;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="479" y="352" as="sourcePoint"/><mxPoint x="479" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a27" style="endArrow=classic;strokeColor=#3A6B4A;strokeWidth=1.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="470" as="sourcePoint"/><mxPoint x="900" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a28" value="時間 →" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#3A6B4A;align=left;" vertex="1" parent="1"><mxGeometry x="905" y="462" width="80" height="18" as="geometry"/></mxCell><mxCell id="a29" value="要点: 同じ「本体1回」あたりの確定トークン数を τ=期待受理長ぶん増やす。分布は棄却サンプリングで p のまま (次図)。" style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1020" height="40" as="geometry"/></mxCell></root></mxGraphModel>