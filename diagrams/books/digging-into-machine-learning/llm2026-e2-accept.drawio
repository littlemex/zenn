<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b2" value="受理率 α = Σ min(p,q)、残差 (p−q)+ から再サンプルして分布は p に戻る" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1000" height="30" as="geometry"/></mxCell><mxCell id="b3" value="語彙 (横軸) 上に本体分布 p とドラフト分布 q を重ねる。重なり (濃緑塗り) の総面積が受理率 α = 1 − TV(p,q)。p が q を上回るはみ出し (薄緑塗り) が残差 (p−q)+ で、棄却時はここから引き直す。両者の和が p を復元する [定理]。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1000" height="40" as="geometry"/></mxCell><mxCell id="b4" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="840" height="320" as="geometry"/></mxCell><mxCell id="b5" value="" style="rounded=0;fillColor=#2E9E5B;strokeColor=#14532D;strokeWidth=1;opacity=85;" vertex="1" parent="1"><mxGeometry x="126" y="425" width="93" height="45" as="geometry"/></mxCell><mxCell id="b6" value="" style="rounded=0;fillColor=#D9D9D9;strokeColor=#9A9A9A;strokeWidth=1;dashed=1;opacity=70;" vertex="1" parent="1"><mxGeometry x="126" y="398" width="93" height="27" as="geometry"/></mxCell><mxCell id="b7" value="" style="rounded=0;fillColor=#2E9E5B;strokeColor=#14532D;strokeWidth=1;opacity=85;" vertex="1" parent="1"><mxGeometry x="231" y="379" width="93" height="91" as="geometry"/></mxCell><mxCell id="b8" value="" style="rounded=0;fillColor=#D9D9D9;strokeColor=#9A9A9A;strokeWidth=1;dashed=1;opacity=70;" vertex="1" parent="1"><mxGeometry x="231" y="343" width="93" height="36" as="geometry"/></mxCell><mxCell id="b9" value="" style="rounded=0;fillColor=#2E9E5B;strokeColor=#14532D;strokeWidth=1;opacity=85;" vertex=