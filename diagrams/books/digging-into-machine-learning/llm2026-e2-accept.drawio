A;align=center;" vertex="1" parent="1"><mxGeometry x="892" y="474" width="30" height="14" as="geometry"/></mxCell><mxCell id="b59" value="語彙 (次トークン候補)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="492" width="180" height="16" as="geometry"/></mxCell><mxCell id="b60" value="確率" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="302" width="50" height="16" as="geometry"/></mxCell><mxCell id="b61" value="" style="rounded=1;fillColor=#2E9E5B;strokeColor=#14532D;" vertex="1" parent="1"><mxGeometry x="710" y="160" width="22" height="14" as="geometry"/></mxCell><mxCell id="b62" value="min(p,q): 受理 (面積=α)" style="text;html=1;fontSize=11;fontColor=#14532D;align=left;" vertex="1" parent="1"><mxGeometry x="738" y="158" width="220" height="18" as="geometry"/></mxCell><mxCell id="b63" value="" style="rounded=1;fillColor=#8FCBA6;strokeColor=#2E9E5B;" vertex="1" parent="1"><mxGeometry x="710" y="184" width="22" height="14" as="geometry"/></mxCell><mxCell id="b64" value="(p−q)+: 棄却後に再サンプル" style="text;html=1;fontSize=11;fontColor=#14532D;align=left;" vertex="1" parent="1"><mxGeometry x="738" y="182" width="220" height="18" as="geometry"/></mxCell><mxCell id="b65" value="Σ min(p,q) + Σ (p−q)+ = 1、受理経路 min(p,q) と再サンプル経路 (p−q)+ の和が各点で p(x) を復元する。α = Σ min(p,q) = 1 − TV(p,q)。" style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel>