<mxCell id="t1" value="FlowPrefill: 「中断できる粒度」と「スケジュール判断の頻度」を切り離す" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="横軸は時間。長い Prefill L が走っている最中に短いリクエスト S が到着する状況で、S の初回トークンまでの待ち(TTFT)がどう変わるかを 3 つのスケジューラで比較する。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1120" height="20" as="geometry"/></mxCell>
<mxCell id="axis" value="時間 →" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#3A6B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="205" y="80" width="120" height="18" as="geometry"/></mxCell>
<mxCell id="sarr" style="endArrow=classic;html=1;strokeColor=#B45309;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="104" as="sourcePoint"/><mxPoint x="330" y="700" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="sarrl" value="短い S が到着" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#B45309;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="336" y="86" width="160" height="18" as="geometry"/></mxCell>

<mxCell id="r1l" value="(A) 素朴&#10;(FCFS)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="r1L" value="長い Prefill L を最後まで実行(中断しない)" style="rounded=0;fillColor=#8FCBA6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=12;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="205" y="130" width="560" height="40" as="geometry"/></mxCell>
<mxCell id="r1wait" value="S はここまで待たされる = HoL blocking" style="rounded=0;fillColor=#F5E6D0;strokeColor=#C77D2E;fontColor=#B45309;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="178" width="435" height="20" as="geometry"/></mxCell>
<mxCell id="r1S" value="S 実行" style="rounded=0;fillColor=#B7E1C6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="770" y="130" width="110" height="40" as="geometry"/></mxCell>

<mxCell id="r2l" value="(B) chunked&#10;prefill" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="r2c1" value="L 1" style="rounded=0;fillColor=#8FCBA6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="205" y="250" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="r2S" value="S 実行" style="rounded=0;fillColor=#B7E1C6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="331" y="250" width="110" height="40" as="geometry"/></mxCell>
<mxCell id="r2c2" value="L 2" style="rounded=0;fillColor=#8FCBA6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="447" y="250" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="r2c3" value="L 3" style="rounded=0;fillColor=#8FCBA6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="573" y="250" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="r2c4" value="L 4" style="rounded=0;fillColor=#8FCBA6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="699" y="250" width="66" height="40" as="geometry"/></mxCell>
<mxCell id="r2note" value="固定長 chunk の合間に S を挟む。ジレンマ: chunk を小さくすると待ちは減るが、カーネル起動増・過去 KV 再ロード・低利用で効率が落ちる。大きくすると効率は戻るが待ちが悪化。粒度と判断頻度が「chunk サイズ」1 つに縛られている。" style="text;html=1;fontSize=11;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="205" y="294" width="560" height="34" as="geometry"/></mxCell>

<mxCell id="r3l" value="(C) FlowPrefill" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="150" height="90" as="geometry"/></mxCell>
<mxCell id="r3La" value="L(分割しない・operator 境界で中断可)" style="rounded=0;fillColor=#8FCBA6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="205" y="380" width="120" height="44" as="geometry"/></mxCell>
<mxCell id="r3S" value="S 実行" style="rounded=0;fillColor=#B7E1C6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="331" y="380" width="110" height="44" as="geometry"/></mxCell>
<mxCell id="r3Lb" value="L を resume" style="rounded=0;fillColor=#8FCBA6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=11;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="447" y="380" width="318" height="44" as="geometry"/></mxCell>
<mxCell id="tick1" style="endArrow=none;html=1;strokeColor=#0E3D20;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="380" as="sourcePoint"/><mxPoint x="235" y="424" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="tick2" style="endArrow=none;html=1;strokeColor=#0E3D20;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="380" as="sourcePoint"/><mxPoint x="265" y="424" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="tick3" style="endArrow=none;html=1;strokeColor=#0E3D20;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="380" as="sourcePoint"/><mxPoint x="295" y="424" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="tickl" value="↑ operator 境界(qkv_proj / attn / o_proj / gate_up_proj / down_proj)= 中断してよい細かい地点" style="text;html=1;fontSize=10;fontColor=#0E3D20;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="205" y="426" width="560" height="16" as="geometry"/></mxCell>
<mxCell id="r3ev" value="S 到着イベントで判断→次の operator 境界で中断" style="text;html=1;fontSize=10;fontColor=#B45309;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="331" y="358" width="200" height="20" as="geometry"/></mxCell>

<mxCell id="d1" value="&lt;b style=&quot;font-size:14px&quot;&gt;分離 1: 実行の粒度&lt;/b&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;リクエストを chunk に切らず(without request splitting)、1 回の順伝播の内部の operator 境界で中断する。中断できる粒度は細かいままにできる。&lt;/div&gt;" style="rounded=1;fillColor=#E8F3EC;strokeColor=#1E7A45;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;html=1;whiteSpace=wrap;spacing=10;" vertex="1" parent="1"><mxGeometry x="205" y="470" width="295" height="140" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b style=&quot;font-size:14px&quot;&gt;分離 2: スケジュール判断の頻度&lt;/b&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;判断はリクエストの到着と完了という 2 イベントのときだけ。固定間隔ポーリングをしない。operator 境界は「中断してよい地点」であって判断のトリガではない。&lt;/div&gt;" style="rounded=1;fillColor=#E8F3EC;strokeColor=#1E7A45;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;html=1;whiteSpace=wrap;spacing=10;" vertex="1" parent="1"><mxGeometry x="515" y="470" width="295" height="140" as="geometry"/></mxCell>
<mxCell id="d3" value="&lt;b style=&quot;font-size:14px&quot;&gt;優先度: S-EDF(slack を見た EDF)&lt;/b&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;priority = sgn(slack) / deadline。slack = deadline − now − 予測 TTFT(トークン数の多項式フィット)。プロンプト長は予測 TTFT を通じて&lt;b&gt;間接的&lt;/b&gt;にしか効かない。&lt;/div&gt;" style="rounded=1;fillColor=#B7E1C6;strokeColor=#0E3D20;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;html=1;whiteSpace=wrap;spacing=10;" vertex="1" parent="1"><mxGeometry x="825" y="470" width="315" height="140" as="geometry"/></mxCell>

<mxCell id="foot" value="報告値: SOTA 比で最大 5.6× の goodput(SLO を満たしたリクエストのスループット)。operator 粒度のプリエンプションは layer 粒度比で平均ブロッキング時間を 3.5×–4.2× 削減。実装は vLLM 0.11.2 上のプロトタイプ(本体未マージ)。" style="text;html=1;fontSize=11;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="205" y="624" width="935" height="40" as="geometry"/></mxCell>
</root></mxGraphModel>
