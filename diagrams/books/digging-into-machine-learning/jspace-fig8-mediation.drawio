        <mxCell id="c47" value="&lt;b&gt;0.23&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#52B788;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="970" y="354.5090909090909" width="80" height="24" as="geometry"/></mxCell>
        <mxCell id="c48" value="ベースも動く (0.38 → 0.48)。&lt;br&gt;訓練効果 0.33 が 0.25 に縮むだけ" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#40916C;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="634" y="478" width="500" height="46" as="geometry"/></mxCell>
        <mxCell id="c49" value="&lt;b&gt;この図が示すこと&lt;/b&gt;: 捏造側は「訓練が植えたものだけを消した」と読める。欺瞞側は ablation がベース由来のものも消しているので、同じ引き算に意味を持たせるには処理と媒介の加法性という仮定が要る。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="556" width="1116" height="60" as="geometry"/></mxCell>
        <mxCell id="c50" value="差の差 (difference-in-differences) は記述量である。ablation は媒介変数を特定の値に固定する介入 (統制直接効果の系列) なので、そこから自然間接効果を引き算で取り出すには、統制直接効果が固定値に依らないという追加の仮定が必要になる。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=2;fontSize=15;fontColor=#B26B4A;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="628" width="1116" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
