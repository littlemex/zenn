<mxfile host="app.diagrams.net">
  <diagram id="jspace-scaffold" name="足場の剥がし方">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="704" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;この実験の強さは「足場をどこで剥がすか」に全面的に依存している&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=27;fontColor=#1B4332;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="constitution は生成時にしか存在せず、内省質問は訓練時にしか存在しない。評価時にはどちらもない" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#40916C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1120" height="26" as="geometry"/></mxCell>
        <mxCell id="c3" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="132" width="358" height="384" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;1. 目標の内省を生成する&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#2D6A4F;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="146" width="326" height="44" as="geometry"/></mxCell>
        <mxCell id="c5" value="課題文脈 (途中で切った agentic 転写)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52B788;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="204" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c6" value="内省質問 (「いま最も正直な行動は何か」)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52B788;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="270" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c7" value="constitution から抜いた 20 原則" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B26B4A;strokeWidth=2;fontSize=14;fontColor=#B26B4A;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="336" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c8" value="→ 出力: 課題に接地した 2-4 段落の内省" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D6A4F;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="402" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c9" value="ここだけで constitution を見せる" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="58" y="468" width="326" height="40" as="geometry"/></mxCell>
        <mxCell id="c10" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="420" y="132" width="358" height="384" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;2. その足場を剥がして訓練する&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#2D6A4F;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="436" y="146" width="326" height="44" as="geometry"/></mxCell>
        <mxCell id="c12" value="課題文脈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52B788;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="436" y="204" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c13" value="内省質問" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52B788;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="436" y="270" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;s&gt;constitution から抜いた 20 原則&lt;/s&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F4F3;strokeColor=#8FA79B;strokeWidth=1;fontSize=14;fontColor=#8FA79B;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="436" y="336" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c15" value="→ 損失は内省ターンにのみ計算する" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D6A4F;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="436" y="402" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c16" value="constitution は訓練例に残らない" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B7E4C7;strokeColor=#40916C;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="436" y="468" width="326" height="40" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#CDE9DC;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="798" y="132" width="358" height="384" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;3. 評価する&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#95D5B2;strokeColor=#2D6A4F;strokeWidth=2;fontSize=17;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="814" y="146" width="326" height="44" as="geometry"/></mxCell>
        <mxCell id="c19" value="課題文脈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#52B788;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="814" y="204" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;s&gt;内省質問&lt;/s&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F4F3;strokeColor=#8FA79B;strokeWidth=1;fontSize=14;fontColor=#8FA79B;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="814" y="270" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;s&gt;constitution から抜いた 20 原則&lt;/s&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F4F3;strokeColor=#8FA79B;strokeWidth=1;fontSize=14;fontColor=#8FA79B;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="814" y="336" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c22" value="→ 内省テキストは一度も生成させない" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D6A4F;strokeWidth=2;fontSize=14;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="814" y="402" width="326" height="56" as="geometry"/></mxCell>
        <mxCell id="c23" value="促さないのに行動が変わる" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#95D5B2;strokeColor=#40916C;strokeWidth=1;fontSize=14;fontColor=#1B4332;align=center;verticalAlign=middle;spacing=4;shadow=0;" vertex="1" parent="1"><mxGeometry x="814" y="468" width="326" height="40" as="geometry"/></mxCell>
        <mxCell id="l24" value="" style="edgeStyle=none;html=1;strokeWidth=3;strokeColor=#40916C;endArrow=block;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="402" y="330" as="sourcePoint"/><mxPoint x="418" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l25" value="" style="edgeStyle=none;html=1;strokeWidth=3;strokeColor=#40916C;endArrow=block;endFill=1;fontSize=14;fontColor=#1B4332;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="330" as="sourcePoint"/><mxPoint x="796" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c26" value="&lt;b&gt;読み間違えやすい 2 点&lt;/b&gt;: (1) constitution を訓練データに入れたのではない。生成時のプロンプトにだけ入れ、最終の訓練例からは剥がしている。(2) 評価で内省させたのでもない。内省質問すら与えず、モデルは内省テキストを一切出さない。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#D8F3DC;strokeColor=#40916C;strokeWidth=2;fontSize=16;fontColor=#1B4332;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="536" width="1116" height="66" as="geometry"/></mxCell>
        <mxCell id="c27" value="&lt;b&gt;ただし選択と評価が同じデータの上にある&lt;/b&gt;: 「もっとも活性化が増えたトークン」と curate した倫理関連リスト (捏造 176 語、欺瞞 63 語) は、効果を測るのと同じデータを見てから選ばれている。選択後に同じデータで評価すると効果量は上振れするので、入れ子の検証集合か交差適合で選択と評価を分ける必要がある。" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FBF3EE;strokeColor=#B26B4A;strokeWidth=2;fontSize=15;fontColor=#B26B4A;verticalAlign=middle;align=center;spacing=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="42" y="614" width="1116" height="74" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
