<mxCell id="t1" value="実装で「どこまで重ねられるか」: vLLM と SGLang の対比(2026-07 時点)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1140" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="○ 同時利用の実在レシピあり  △ 起動は通るが公式レシピ/CI に同時構成なし  × 実装が同時利用を明示的に禁止(アサート)  - 該当機能が本体に無い" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1140" height="20" as="geometry"/></mxCell>
<mxCell id="h0" value="組み合わせ" style="rounded=0;fillColor=#14532D;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="360" height="50" as="geometry"/></mxCell>
<mxCell id="h1" value="vLLM (afd-plugin 0.19.1 pin)" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="h2" value="SGLang (本体 main)" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="h3" value="根拠(実装上の事実)" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="380" height="50" as="geometry"/></mxCell>
<mxCell id="r1a" value="P/D 分離 + EP + MoE" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="r1b" value="○" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r1c" value="○" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r1d" value="両者とも KVConnector / --disaggregation-mode で確立。EP は --enable-expert-parallel / --ep-size" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="140" width="380" height="62" as="geometry"/></mxCell>
<mxCell id="r2a" value="P/D 分離で prefill と decode の EP 通信モードを変える" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="r2b" value="○" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="202" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r2c" value="○" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="202" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r2d" value="SGLang: deepep-mode が prefill→normal(HT) / decode→low_latency(LL) を自動選択。「両者を1通信グループで同時不可」が PD 分離を要する理由。NCCL EP も同じ LL/HT 二分" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="202" width="380" height="62" as="geometry"/></mxCell>
<mxCell id="r3a" value="AFD (Attention/FFN 分離)" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="r3b" value="○&#10;(2p1a1f レシピ)" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="264" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r3c" value="△&#10;(未マージ草案 PR#10900)" style="rounded=0;fillColor=#B7E1C6;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#1B5E33;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="264" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r3d" value="vLLM: plugin として実在(StepMesh 相当は不要、Nixl/NCCL P2P)。SGLang: 本体 main に AFD は無く、StepMesh を使う RFC 草案のみ" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="264" width="380" height="62" as="geometry"/></mxCell>
<mxCell id="r4a" value="AFD + P/D 分離 を同時に" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="r4b" value="○&#10;(小規模のみ検証)" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="326" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r4c" value="×&#10;(草案が明示禁止)" style="rounded=0;fillColor=#EFEFEF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#8A8A8A;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="326" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r4d" value="vLLM: 同一 recipe に同居(decode/attn が kv_consumer かつ afd role=attention)。ただし DeepSeek-V2-Lite 小規模のみ。SGLang: check_afd_server_args() が disaggregation_mode==null を要求" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="326" width="380" height="62" as="geometry"/></mxCell>
<mxCell id="r5a" value="AFD + MoE-A2A(DeepEP) を同時に" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="r5b" value="○&#10;(FFN プール内で EP)" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="388" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r5c" value="×&#10;(草案が明示禁止)" style="rounded=0;fillColor=#EFEFEF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#8A8A8A;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="388" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r5d" value="vLLM: FFN worker が EP で回る前提。SGLang 草案: moe_a2a_backend==none を要求(DeepEP と AFD dispatch が衝突)。FastAFD は独自 MegaMoE で解決" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="388" width="380" height="62" as="geometry"/></mxCell>
<mxCell id="r6a" value="バッチ overlap (DBO / TBO) を P/D 分離と併用" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="r6b" value="○&#10;(eager_dbo レシピあり)" style="rounded=0;fillColor=#2E9E5B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r6c" value="△&#10;(公式 PD で TBO は無効)" style="rounded=0;fillColor=#B7E1C6;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#1B5E33;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="r6d" value="vLLM: 2p1a1f に eager_dbo 版が実在(DeepSeek-V2-Lite のみ)。SGLang: 禁止アサートは無いが公式 PD マニフェストで TBO をコメントアウト、CI も PD+TBO 同時構成なし(PD 無し構成が主用途と推測)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="380" height="62" as="geometry"/></mxCell>
<mxCell id="cap" value="要約: vLLM は AFD を核に P/D と EP を薄く重ねた小規模実証を持つ。SGLang は AFD 以外の技術(P/D + EP + DP attention + TBO)を大規模実運用する一方、AFD だけは他の分離と排他の実験段階。両者に共通する壁は「prefill(HT)と decode(LL)で EP 通信が別物」という非対称であり、これが分離を後押しする。なお FlowPrefill(軸3)は本体未マージのため他軸との同時レシピが無く、この表には現れない。" style="text;html=1;fontSize=12;fontColor=#14532D;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="1140" height="60" as="geometry"/></mxCell>
</root></mxGraphModel>