<mxfile host="app.diagrams.net" modified="2026-08-04T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram id="pool-logic" name="accelerator_pools Logic Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="accelerator_pools: 入力から Kubernetes リソース生成までのフロー" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Column 1: input -->
        <mxCell id="input-header" value="① 入力 (terraform.tfvars)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="input-box" value="&lt;b&gt;accelerator_pools&lt;/b&gt;&lt;br&gt;&lt;br&gt;instance_types&lt;br&gt;capacity_types / capacity_type*&lt;br&gt;zones / zone*&lt;br&gt;capacity_reservations / cb_reservation_id*&lt;br&gt;efa_interface_count&lt;br&gt;disruption / interruptible*&lt;br&gt;labels, taints&lt;br&gt;&lt;br&gt;&lt;i&gt;* = 旧フィールド (後方互換)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="200" as="geometry" />
        </mxCell>

        <!-- Column 2 upper: normalization -->
        <mxCell id="norm-header" value="② 正規化 (pool_effective)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="norm-box" value="&lt;b&gt;pool_effective&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(左が優先)&lt;/i&gt;&lt;br&gt;&lt;br&gt;capacity_types: 新list ▶ [旧] ▶ [on-demand]&lt;br&gt;has_reserved: contains(reserved)&lt;br&gt;reservation_ids: 新ids ∪ 旧 cb_id&lt;br&gt;reservation_tags: 新tags&lt;br&gt;zones: 新 ▶ [旧 zone] ▶ [] (導出)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="300" height="160" as="geometry" />
        </mxCell>

        <!-- Column 2 lower: EFA derivation -->
        <mxCell id="efa-header" value="② EFA 導出 (EC2 API)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#0D9488;" vertex="1" parent="1">
          <mxGeometry x="360" y="400" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="efa-box" value="&lt;b&gt;data.aws_ec2_instance_type&lt;/b&gt;&lt;br&gt;&lt;br&gt;efa_supported → cards (0 = EFA なし)&lt;br&gt;efa_maximum_interfaces → count / multi_card&lt;br&gt;&lt;br&gt;pool_efa: 明示指定 ▶ API 値&lt;br&gt;schedulable = multi_card ? cards-1 : cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="430" width="300" height="150" as="geometry" />
        </mxCell>

        <!-- Column 2 middle: AZ resolution (CB describe -> pool_zone) -->
        <mxCell id="az-header" value="② AZ 解決 (CB describe → pool_zone)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#0891B2;" vertex="1" parent="1">
          <mxGeometry x="360" y="600" width="360" height="24" as="geometry" />
        </mxCell>
        <mxCell id="az-box" value="&lt;b&gt;pool_cb_zone / pool_zone&lt;/b&gt;&lt;br&gt;&lt;br&gt;CB describe: reservation_ids (id ベース) のみ&lt;br&gt;zone 導出: 明示 zone ▶ CB の AZ ▶ azs[0]&lt;br&gt;requirement values: 空=[azs[0]] / 明示 / &quot;*&quot;=全AZ&lt;br&gt;&lt;br&gt;&lt;i&gt;※ CB の AZ 自動解決は旧 capacity_type=reserved のみ&lt;br&gt;(新 capacity_types=[reserved] は zones 明示必須)&lt;br&gt;※ tag のみ指定の予約は describe / expiry alert 対象外&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="630" width="360" height="150" as="geometry" />
        </mxCell>

        <!-- Column 3: disruption preset -->
        <mxCell id="disr-header" value="③ Disruption Preset" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="740" y="272" width="280" height="24" as="geometry" />
        </mxCell>
        <mxCell id="disr-box" value="&lt;b&gt;pool_disruption_preset&lt;/b&gt;&lt;br&gt;&lt;br&gt;優先順:&lt;br&gt;1. 明示 disruption field&lt;br&gt;2. interruptible (旧)&lt;br&gt;3. 導出: efa&gt;0 OR has_reserved → protect&lt;br&gt;&lt;br&gt;&lt;b&gt;presets:&lt;/b&gt;&lt;br&gt;protect: Never / budget 0&lt;br&gt;reclaim: 5m / budget 10%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- Column 4: rendered Kubernetes resources -->
        <mxCell id="render-header" value="④ レンダリング (Kubernetes リソース)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="1120" y="80" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="np-box" value="&lt;b&gt;NodePool&lt;/b&gt;&lt;br&gt;&lt;br&gt;requirements:&lt;br&gt;&amp;nbsp;&amp;nbsp;capacity-type In [values]&lt;br&gt;&amp;nbsp;&amp;nbsp;instance-type In [types]&lt;br&gt;&amp;nbsp;&amp;nbsp;zone In [az…] &lt;i&gt;(空=単一 / 明示=multi / &quot;*&quot;=全AZ)&lt;/i&gt;&lt;br&gt;&lt;br&gt;disruption:&lt;br&gt;&amp;nbsp;&amp;nbsp;consolidateAfter&lt;br&gt;&amp;nbsp;&amp;nbsp;budgets: [{nodes}]&lt;br&gt;&lt;br&gt;labels: merge(user, module)&lt;br&gt;taints: [device] + user&lt;br&gt;&lt;br&gt;&lt;i&gt;multi-AZ 分散(topologySpread)は Pod 側&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065F46;strokeColor=#064E3B;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="110" width="280" height="250" as="geometry" />
        </mxCell>
        <mxCell id="nc-box" value="&lt;b&gt;EC2NodeClass&lt;/b&gt;&lt;br&gt;&lt;br&gt;networkInterfaces:&lt;br&gt;&amp;nbsp;&amp;nbsp;EFA multi-card / single-card / なし&lt;br&gt;&lt;br&gt;capacityReservationSelectorTerms:&lt;br&gt;&amp;nbsp;&amp;nbsp;[{id}, {tags}] (reserved のみ)&lt;br&gt;&lt;br&gt;amiSelectorTerms&lt;br&gt;blockDeviceMappings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065F46;strokeColor=#064E3B;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="430" width="280" height="190" as="geometry" />
        </mxCell>

        <!-- Edges. Every one pins exit/entry so draw.io cannot route through a box. -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="input-box" target="norm-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="input-box" target="efa-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" value="has_reserved を参照" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="norm-box" target="disr-box">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-46" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow4" value="efa cards を参照" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#D97706;dashed=1;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="efa-box" target="disr-box">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-6" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow5" value="requirements / labels / taints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#059669;fontSize=11;fontColor=#065F46;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="norm-box" target="np-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow6" value="networkInterfaces / CR selector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0D9488;fontSize=11;fontColor=#134E4A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="efa-box" target="nc-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow7" value="disruption block" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#D97706;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="disr-box" target="np-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- NodePool references EC2NodeClass. Drawn thin/dashed so it reads as a reference,
             not as another step in the left-to-right pipeline. -->
        <mxCell id="arrow8" value="nodeClassRef" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#6B7280;dashed=1;fontSize=11;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="np-box" target="nc-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- normalization feeds AZ resolution (reservation_ids / zones) -->
        <mxCell id="arrow9" value="reservation_ids / zones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0891B2;fontSize=11;fontColor=#155E75;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="norm-box" target="az-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="330" y="255" /><mxPoint x="330" y="675" /></Array>
          </mxGeometry>
        </mxCell>
        <!-- AZ resolution feeds the NodePool zone requirement (route below disruption box) -->
        <mxCell id="arrow10" value="zone In [az…]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#0891B2;fontSize=11;fontColor=#155E75;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="az-box" target="np-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1060" y="705" /><mxPoint x="1060" y="320" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- Validation is not a pipeline stage; dashed border + note keep it from reading as one. -->
        <mxCell id="val-header" value="バリデーション — plan 時の横断チェック (変数 validation〈入力時〉+ precondition〈導出値を plan 時に検証〉の2段)" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="val-box" value="EFA × multi-AZ 禁止 (2段)  |  reserved × multi-AZ 禁止  |  cr- 形式検証  |  zone/zones・capacity_type/capacity_types 相互排他  |  restricted domain labels  |  taint effect 値域  |  device-plugin key 重複禁止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;dashed=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1360" height="50" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;: 実線 = 値がそのまま流れる / 破線 = 値を参照する (導出条件への入力を含む) / 矢印の色 = 流れ込む先のレイヤーの色" style="text;html=1;align=left;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="935" width="1100" height="24" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
