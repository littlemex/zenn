<mxfile host="app.diagrams.net" modified="2026-08-01T12:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram id="pool-logic" name="accelerator_pools Logic Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="accelerator_pools: 入力から Kubernetes リソース生成までのフロー" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- ===== INPUT LAYER (Gray) ===== -->
        <mxCell id="input-header" value="入力 (terraform.tfvars)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="input-box" value="&lt;b&gt;accelerator_pools&lt;/b&gt;&lt;br&gt;&lt;br&gt;instance_types&lt;br&gt;capacity_types / capacity_type&lt;br&gt;zones / zone&lt;br&gt;capacity_reservations / cb_reservation_id&lt;br&gt;efa_interface_count&lt;br&gt;disruption / interruptible&lt;br&gt;labels, taints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- ===== NORMALIZATION LAYER (Light Green) ===== -->
        <mxCell id="norm-header" value="正規化 (pool_effective)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="norm-box" value="&lt;b&gt;pool_effective&lt;/b&gt;&lt;br&gt;&lt;br&gt;capacity_types: new list &gt; [legacy] &gt; [on-demand]&lt;br&gt;has_reserved: contains(reserved)&lt;br&gt;reservation_ids: new ids ∪ legacy cb_id&lt;br&gt;reservation_tags: new tags&lt;br&gt;zones: new &gt; [legacy zone] &gt; [] (derive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#6EE7B7;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- Arrow: Input → Norm -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#6EE7B7;" edge="1" parent="1" source="input-box" target="norm-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== EFA LAYER (Teal) ===== -->
        <mxCell id="efa-header" value="EFA 導出 (EC2 API)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0D9488;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="efa-box" value="&lt;b&gt;data.aws_ec2_instance_type&lt;/b&gt;&lt;br&gt;&lt;br&gt;efa_supported → cards (0 = no EFA)&lt;br&gt;efa_maximum_interfaces → count / multi_card&lt;br&gt;&lt;br&gt;pool_efa: explicit override &gt; API value&lt;br&gt;schedulable = multi_card ? cards-1 : cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#5EEAD4;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- Arrow: Input → EFA -->
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#5EEAD4;" edge="1" parent="1" source="input-box" target="efa-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== DISRUPTION LAYER (Orange) ===== -->
        <mxCell id="disr-header" value="Disruption Preset" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="disr-box" value="&lt;b&gt;pool_disruption_preset&lt;/b&gt;&lt;br&gt;&lt;br&gt;優先順:&lt;br&gt;1. explicit disruption field&lt;br&gt;2. interruptible (deprecated)&lt;br&gt;3. derived: efa&gt;0 OR has_reserved → protect&lt;br&gt;&lt;br&gt;&lt;b&gt;disruption_presets table&lt;/b&gt;&lt;br&gt;protect: Never / budget 0&lt;br&gt;reclaim: 5m / budget 10%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#FCD34D;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="330" width="260" height="170" as="geometry" />
        </mxCell>

        <!-- Arrow: Norm → Disruption -->
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FCD34D;" edge="1" parent="1" source="norm-box" target="disr-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Arrow: EFA → Disruption -->
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FCD34D;" edge="1" parent="1" source="efa-box" target="disr-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== RENDER LAYER (Dark Green) ===== -->
        <mxCell id="render-header" value="レンダリング (Kubernetes リソース)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="280" height="20" as="geometry" />
        </mxCell>

        <mxCell id="np-box" value="&lt;b&gt;NodePool&lt;/b&gt;&lt;br&gt;&lt;br&gt;requirements:&lt;br&gt;  capacity-type In [values]&lt;br&gt;  instance-type In [types]&lt;br&gt;  zone In [az]&lt;br&gt;&lt;br&gt;disruption:&lt;br&gt;  consolidateAfter&lt;br&gt;  budgets: [{nodes}]&lt;br&gt;&lt;br&gt;labels: merge(user, module)&lt;br&gt;taints: [device] + user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065F46;strokeColor=#047857;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="110" width="240" height="220" as="geometry" />
        </mxCell>

        <mxCell id="nc-box" value="&lt;b&gt;EC2NodeClass&lt;/b&gt;&lt;br&gt;&lt;br&gt;networkInterfaces:&lt;br&gt;  EFA multi-card / single-card / none&lt;br&gt;&lt;br&gt;capacityReservationSelectorTerms:&lt;br&gt;  [{id}, {tags}] (reserved only)&lt;br&gt;&lt;br&gt;amiSelectorTerms&lt;br&gt;blockDeviceMappings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065F46;strokeColor=#047857;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="360" width="240" height="180" as="geometry" />
        </mxCell>

        <!-- Arrows to Render -->
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#10B981;" edge="1" parent="1" source="norm-box" target="np-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#10B981;" edge="1" parent="1" source="efa-box" target="nc-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#F59E0B;" edge="1" parent="1" source="disr-box" target="np-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== VALIDATION (Red, bottom strip) ===== -->
        <mxCell id="val-header" value="バリデーション (plan 時に検出)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="val-box" value="EFA x multi-AZ 禁止  |  reserved x multi-AZ 禁止  |  cr- 形式検証  |  zone/zones 相互排他  |  restricted domain labels  |  taint effect 値域  |  device-plugin key 重複禁止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#FCA5A5;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1220" height="40" as="geometry" />
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;: 灰=入力 / 薄緑=正規化 / 青緑=EFA導出(EC2 API) / 黄=disruption / 濃緑=K8sリソース / 赤=バリデーション" style="text;html=1;align=left;fontSize=10;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="800" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
