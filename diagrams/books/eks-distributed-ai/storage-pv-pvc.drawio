<mxCell id="warn" value="Amazon FSx for Lustre 固有の 3 つの注意点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=#1E7E5A;fontSize=18;fontColor=#FFFFFF;fontStyle=1;arcSize=8;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1480" height="40" as="geometry" /></mxCell>
<mxCell id="w1" value="動的プロビジョニング不可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#2FA374;strokeWidth=2;fontSize=16;fontColor=#14442F;fontStyle=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="480" height="130" as="geometry" /></mxCell>
<mxCell id="w1d" value="StorageClass 経由で既存 FS に
バインドできない。固定 volumeHandle の
静的 PV を 1 つ用意し PVC を名指しする。
誤ると 2 つ目の FS が課金され得る。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#14442F;" vertex="1" parent="1"><mxGeometry x="70" y="654" width="460" height="90" as="geometry" /></mxCell>
<mxCell id="w2" value="volumeAttributes は小文字キー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#2FA374;strokeWidth=2;fontSize=16;fontColor=#14442F;fontStyle=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="480" height="130" as="geometry" /></mxCell>
<mxCell id="w2d" value="dnsname / mountname のみ読まれる。
dnsName のようなキャメルケースは
無視され NodeStageVolume が失敗し
Pod が ContainerCreating で止まる。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#14442F;" vertex="1" parent="1"><mxGeometry x="570" y="654" width="460" height="90" as="geometry" /></mxCell>
<mxCell id="w3" value="reclaimPolicy は Retain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#2FA374;strokeWidth=2;fontSize=16;fontColor=#14442F;fontStyle=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1060" y="620" width="480" height="130" as="geometry" /></mxCell>
<mxCell id="w3d" value="PVC を消しても PV は Released で残る。
Recycle は非推奨かつ CSI 未実装。
再バインドの復旧手順は Basic02 と共通
(PV は PVC を実体で覚えるため)。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#14442F;" vertex="1" parent="1"><mxGeometry x="1070" y="654" width="460" height="90" as="geometry" /></mxCell>
</root></mxGraphModel></diagram></mxfile>