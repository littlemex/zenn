<mxCell id="pvd" value="volumeHandle = ファイルシステム ID
volumeAttributes { dnsname, mountname }
storageClassName = &quot;&quot; (静的)
reclaimPolicy = Retain / mountOptions = flock" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#14442F;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="470" y="278" width="300" height="120" as="geometry" /></mxCell>
