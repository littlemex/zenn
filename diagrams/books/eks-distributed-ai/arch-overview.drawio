Cell id="colc" value="計算 (compute)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2FA374;strokeWidth=1.2;dashed=1;dashPattern=10 6;fontSize=18;fontColor=#14442F;fontStyle=1;arcSize=6;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="180" y="760" width="520" height="780" as="geometry"/></mxCell><mxCell id="sysng" value="System ノードグループ&#xa;m5.xlarge x2 (kube-system・足場)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#1E7E5A;strokeWidth=2;dashed=0;fontSize=19;fontColor=#14442F;fontStyle=0;arcSize=8;verticalAlign=middle;align=center;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="200" y="800" width="480" height="90" as="geometry"/></mxCell><mxCell id="karp" value="Karpenter コントローラ&#xa;Pod 要求に応じ NodePool 定義に従いノードを起動・回収" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=#1E7E5A;strokeWidth=2;fontSize=18;fontColor=#FFFFFF;fontStyle=1;arcSize=8;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="910" width="480" height="80" as="geometry"/></mxCell><mxCell id="np" value="NodePool 群 (Karpenter がノードを動的起動)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#2FA374;strokeWidth=2.5;dashed=1;dashPattern=10 6;fontSize=18;fontColor=#14442F;fontStyle=1;arcSize=8;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="200" y="1020" width="490" height="500" as="geometry"/></mxCell><mxCell id="pg" value="gpu-p5en&#xa;p5en.48xlarge / H200 x8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#1E7E5A;strokeWidth=1.5;dashed=0;fontSize=16;fontColor=#14442F;fontStyle=1;arcSize=8;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;spacingTop=8;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="222" y="1070" width="210" height="78" as="geometry"/></mxCell><mxCell id="pgt" value="CB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E7E5A;fontSize=15;fontColor=#1E7E5A;fontStyle=1;arcSize=25;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="368" y="1078" width="54" height="22" as="geometry"/></mxCell><mxCell id="pt" value="gpu-dev&#xa;g6e.12xlarge / L40S x4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#1E7E5A;strokeWidth=1.5;dashed=0;fontSize=16;fontColor=#14442F;fontStyle=1;arcSize=8;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;spacingTop=8;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="458" y="1070" width="210" height="78" as="geometry"/></mxCell><mxCell id="ptt" value="OD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2FA374;fontSize=15;fontColor=#2FA374;fontStyle=1;arcSize=25;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="604" y="1078" width="54" height="22" as="geometry"/></mxCell><mxCell id="pn" value="trn2&#xa;trn2.48xlarge / Trainium2 x16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#1E7E5A;strokeWidth=1.5;dashed=0;fontSize=16;fontColor=#14442F;fontStyle=1;arcSize=8;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;spacingTop=8;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="222" y="1200" width="210" height="78" as="geometry"/></mxCell><mxCell id="pnt" value="CB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E7E5A;fontSize=15;fontColor=#1E7E5A;fontStyle=1;arcSize=25;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="368" y="1208" width="54" height="22" as="geometry"/></mxCell><mxCell id="pc" value="cpu&#xa;汎用ワークロード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#1E7E5A;strokeWidth=1.5;dashed=0;fontSize=16;fontColor=#14442F;fontStyle=1;arcSize=8;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;spacingTop=8;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="458" y="1200" width="210" height="78" as="geometry"/></mxCell><mxCell id="pct" value="OD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2FA374;fontSize=15;fontColor=#2FA374;fontStyle=1;arcSize=25;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="604" y="1208" width="54" height="22" as="geometry"/></mxCell><mxCell id="npnote" value="各プールは単一 AZ に固定。CB プールは予約が確保された AZ、on-demand プールは先頭 AZ (= AZ-A) に導出。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="222" y="1340" width="446" height="60" as="geometry"/></mxCell><mxCell id="cols" value="共有ストレージ (同一 AZ 同居)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2FA374;strokeWidth=1.2;dashed=1;dashPattern=10 6;fontSize=18;fontColor=#14442F;fontStyle=1;arcSize=6;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="730" y="760" width="500" height="540" as="geometry"/></mxCell><mxCell id="zi" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fsx;" vertex="1" parent="1"><mxGeometry x="760" y="820" width="54" height="54" as="geometry"/></mxCell><mxCell id="zl" value="Amazon FSx for OpenZFS&#xa;単一AZ NFS 共有ホーム (既定)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="822" width="360" height="56" as="geometry"/></mxCell><mxCell id="li" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fsx_for_lustre;" vertex="1" parent="1"><mxGeometry x="760" y="940" width="54" height="54" as="geometry"/></mxCell><mxCell id="ll" value="Amazon FSx for Lustre&#xa;単一AZ 高速スクラッチ (既定)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="942" width="360" height="56" as="geometry"/></mxCell><mxCell id="ei" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_file_system;" vertex="1" parent="1"><mxGeometry x="760" y="1060" width="54" height="54" as="geometry"/></mxCell><mxCell id="el" value="Amazon EFS&#xa;マルチAZ RWX (opt-in / ドライバは常設)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="840" y="1062" width="380" height="56" as="geometry"/></mxCell><mxCell id="snote" value="学習ジョブが S3 へチェックポイント退避 (下記リージョン層)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="1180" width="450" height="40" as="geometry"/></mxCell><mxCell id="e_cs" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;strokeColor=#1E7E5A;strokeWidth=3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="702" y="1255" as="sourcePoint"/><mxPoint x="728" y="1255" as="targetPoint"/></mxGeometry></mxCell><mxCell id="csl" value="同一 AZ 内アクセス&#xa;低レイテンシ / cross-AZ 転送料なし" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1E7E5A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="745" y="1235" width="320" height="44" as="geometry"/></mxCell><mxCell id="azb" value="アベイラビリティゾーン B (us-east-2b) — 要件充足用 (通常は空)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9AA5A0;strokeWidth=1.5;dashed=1;dashPattern=8 6;fontSize=22;fontColor=#5B6B63;fontStyle=1;arcSize=3;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1330" y="430" width="560" height="1180" as="geometry"/></mxCell><mxCell id="azb_pub" value="public subnet (/24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8D3;strokeWidth=1;dashed=1;fontSize=20;fontColor=#5B6B63;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1360" y="500" width="500" height="150" as="geometry"/></mxCell><mxCell id="azb_pri" value="private subnet (/19)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8D3;strokeWidth=1;dashed=1;fontSize=20;fontColor=#5B6B63;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1360" y="680" width="500" height="900" as="geometry"/></mxCell><mxCell id="azb_note" value="この AZ には通常、計算もストレージも置きません。&#xa;VPC を 2 つ以上の AZ で張るのは:&#xa;・EKS コントロールプレーンが 2 AZ 以上の&#xa;  サブネットを要求するため&#xa;・Capacity Block がどの AZ に確保されても&#xa;  対応するサブネットがあるようにするため&#xa;計算を分散するためではありません。&#xa;&#xa;例外は 2 つ:&#xa;・System ノードグループは全 AZ 指定のため&#xa;  ここにも 1 台載りうる (足場であり計算はしない)&#xa;・CB が us-east-2b に確保されれば、その&#xa;  予約プールのノードはここに起動する" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#5B6B63;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1390" y="730" width="450" height="560" as="geometry"/></mxCell><mxCell id="vpce" value="VPC Endpoints:  Interface (ECR / STS / SSM / EC2)  +  Gateway (S3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6F2;strokeColor=#2FA374;strokeWidth=1.5;dashed=0;fontSize=20;fontColor=#14442F;fontStyle=1;arcSize=4;verticalAlign=middle;align=center;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="150" y="1580" width="1100" height="50" as="geometry"/></mxCell><mxCell id="reg" value="リージョン / 外部サービス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14442F;strokeWidth=1.5;dashed=1;dashPattern=10 6;fontSize=22;fontColor=#14442F;fontStyle=1;arcSize=4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2000" y="300" width="470" height="1120" as="geometry"/></mxCell><mxCell id="s3i" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2060" y="400" width="60" height="60" as="geometry"/></mxCell><mxCell id="s3l" value="Amazon S3&#xa;チェックポイント退避 / S3 Gateway エンドポイント経由" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="400" width="320" height="60" as="geometry"/></mxCell><mxCell id="ecri" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="2060" y="600" width="60" height="60" as="geometry"/></mxCell><mxCell id="ecrl" value="Amazon ECR&#xa;全ノードがイメージを pull (VPC エンドポイント経由)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="600" width="320" height="60" as="geometry"/></mxCell><mxCell id="ebi" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="2060" y="800" width="60" height="60" as="geometry"/></mxCell><mxCell id="ebl" value="Amazon EventBridge Scheduler&#xa;CB 期限の 1 時間前に発火" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="800" width="320" height="60" as="geometry"/></mxCell><mxCell id="snsi" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="2060" y="1000" width="60" height="60" as="geometry"/></mxCell><mxCell id="snsl" value="Amazon SNS&#xa;メール通知 (CB 期限)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="1000" width="320" height="60" as="geometry"/></mxCell><mxCell id="ebsns" value="期限通知" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="930" width="300" height="24" as="geometry"/></mxCell><mxCell id="ecp1" style="endArrow=block;endFill=1;html=1;strokeColor=#1E7E5A;strokeWidth=2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="220" as="sourcePoint"/><mxPoint x="440" y="800" as="targetPoint"/><Array as="points"><mxPoint x="1000" y="270"/><mxPoint x="440" y="270"/></Array></mxGeometry></mxCell><mxCell id="ecpl" value="コントロールプレーンが&#xa;ノード/Pod を管理" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1E7E5A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="240" height="40" as="geometry"/></mxCell><mxCell id="enp" style="endArrow=block;endFill=1;html=1;strokeColor=#1E7E5A;strokeWidth=2;rounded=0;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="990" as="sourcePoint"/><mxPoint x="440" y="1018" as="targetPoint"/></mxGeometry></mxCell><mxCell id="enpl" value="NodePool を動的起動" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="448" y="994" width="200" height="22" as="geometry"/></mxCell><mxCell id="es3" style="endArrow=block;endFill=1;html=1;strokeColor=#2FA374;strokeWidth=2;rounded=0;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="1120" as="sourcePoint"/><mxPoint x="2060" y="430" as="targetPoint"/><Array as="points"><mxPoint x="1295" y="1120"/><mxPoint x="1295" y="430"/></Array></mxGeometry></mxCell><mxCell id="f1" value="EKS アドオン層 (図では省略): Karpenter / GPU Operator / EFA device plugin / Neuron device plugin / Kubeflow Training Operator / MPI Operator。&#xa;計算とストレージを同一 AZ に集約するのは、cross-AZ 転送料を避けるためと、EFA/RDMA の集団通信・FSx for Lustre・Capacity Block がいずれも単一 AZ 前提だからです。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1675" width="1900" height="64" as="geometry"/></mxCell><mxCell id="f2" value="凡例:  CB = Capacity Block (GPU 容量予約) / OD = On-Demand (オンデマンド)  ・  実線枠 = 常設 / 緑破線枠 = Karpenter が動的起動・回収するノード / グレー破線 = 要件充足用 (通常は空)&#xa;矢印:  実線 = 管理・データアクセス / 緑点線 = ノードの動的起動 / 灰点線 = S3 への退避" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1750" width="1900" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>