" as="targetPoint"/></mxGeometry></mxCell><mxCell id="csl" value="同一 AZ 内アクセス&#xa;(低レイテンシ・cross-AZ 転送料なし)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#1E7E5A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="545" y="868" width="340" height="40" as="geometry"/></mxCell><mxCell id="azb" value="アベイラビリティゾーン B (us-east-2b) — 待機" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9AA5A0;strokeWidth=1.5;dashed=1;dashPattern=8 6;fontSize=22;fontColor=#5B6B63;fontStyle=1;arcSize=3;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1330" y="430" width="560" height="1180" as="geometry"/></mxCell><mxCell id="azb_pub" value="public subnet (/24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8D3;strokeWidth=1;dashed=1;fontSize=20;fontColor=#5B6B63;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1360" y="500" width="500" height="150" as="geometry"/></mxCell><mxCell id="azb_pri" value="private subnet (/19)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CFD8D3;strokeWidth=1;dashed=1;fontSize=20;fontColor=#5B6B63;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1360" y="680" width="500" height="900" as="geometry"/></mxCell><mxCell id="azb_note" value="この AZ には通常、計算もストレージも置きません。&#xa;&#xa;VPC を 2 つ以上の AZ で張るのは:&#xa;・EKS コントロールプレーンが 2 AZ 以上の&#xa;  サブネットを要求するため&#xa;・Capacity Block がどの AZ に確保されても&#xa;  対応するサブネットがあるようにするため&#xa;&#xa;計算を分散するためではありません。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#5B6B63;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1390" y="760" width="440" height="420" as="geometry"/></mxCell><mxCell id="vpce" value="VPC Endpoints:  Interface (ECR / STS / SSM / EC2)  +  Gateway (S3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6F2;strokeColor=#2FA374;strokeWidth=1.5;dashed=0;fontSize=20;fontColor=#14442F;fontStyle=1;arcSize=4;verticalAlign=middle;align=center;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="150" y="1580" width="1100" height="50" as="geometry"/></mxCell><mxCell id="reg" value="リージョン / 外部サービス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14442F;strokeWidth=1.5;dashed=1;dashPattern=10 6;fontSize=22;fontColor=#14442F;fontStyle=1;arcSize=4;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2000" y="300" width="470" height="1120" as="geometry"/></mxCell><mxCell id="s3i" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2060" y="380" width="60" height="60" as="geometry"/></mxCell><mxCell id="s3l" value="Amazon S3&#xa;チェックポイント退避 / Gateway 経由" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="380" width="320" height="60" as="geometry"/></mxCell><mxCell id="cfi" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="2060" y="560" width="60" height="60" as="geometry"/></mxCell><mxCell id="cfl" value="Amazon CloudFront&#xa;opt-in デモ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="560" width="320" height="60" as="geometry"/></mxCell><mxCell id="ecri" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="2060" y="740" width="60" height="60" as="geometry"/></mxCell><mxCell id="ecrl" value="Amazon ECR&#xa;全ノードが image pull" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="740" width="320" height="60" as="geometry"/></mxCell><mxCell id="ebi" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="2060" y="920" width="60" height="60" as="geometry"/></mxCell><mxCell id="ebl" value="Amazon EventBridge&#xa;Capacity Block 期限を監視" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="920" width="320" height="60" as="geometry"/></mxCell><mxCell id="snsi" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#1E7E5A;strokeColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;fontColor=#14442F;fontStyle=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="2060" y="1100" width="60" height="60" as="geometry"/></mxCell><mxCell id="snsl" value="Amazon SNS&#xa;メール通知 (CB 期限)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=19;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="1100" width="320" height="60" as="geometry"/></mxCell><mxCell id="ebsns" value="CB 期限通知" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2140" y="1030" width="300" height="24" as="geometry"/></mxCell><mxCell id="ecp1" style="endArrow=block;endFill=1;html=1;strokeColor=#1E7E5A;strokeWidth=2;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="220" as="sourcePoint"/><mxPoint x="440" y="800" as="targetPoint"/><Array as="points"><mxPoint x="1000" y="270"/><mxPoint x="440" y="270"/></Array></mxGeometry></mxCell><mxCell id="ecpl" value="コントロールプレーンが&#xa;ノード/Pod を管理" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#1E7E5A;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="240" height="40" as="geometry"/></mxCell><mxCell id="enp" style="endArrow=block;endFill=1;html=1;strokeColor=#1E7E5A;strokeWidth=2;rounded=0;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="990" as="sourcePoint"/><mxPoint x="440" y="1018" as="targetPoint"/></mxGeometry></mxCell><mxCell id="enpl" value="NodePool を動的起動" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="448" y="994" width="200" height="22" as="geometry"/></mxCell><mxCell id="es3" style="endArrow=block;endFill=1;html=1;strokeColor=#2FA374;strokeWidth=2;rounded=0;dashed=1;dashPattern=6 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="1090" as="sourcePoint"/><mxPoint x="2060" y="410" as="targetPoint"/><Array as="points"><mxPoint x="1290" y="1090"/><mxPoint x="1290" y="410"/></Array></mxGeometry></mxCell><mxCell id="f1" value="Karpenter / GPU Operator / EFA device plugin / Neuron device plugin / Kubeflow Training Operator / MPI Operator は EKS アドオン層。&#xa;共有ストレージ (FSx OpenZFS/Lustre) は既定で先頭 AZ に作成され、計算ノードと同一 AZ に同居する。System ノードグループのみ全 AZ のサブネットを指定するため 2 AZ に分散配置されうる (足場であり計算はしない)。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1680" width="1900" height="64" as="geometry"/></mxCell><mxCell id="f2" value="凡例:  実線枠 = 常設  /  緑破線枠 = 動的に起動・回収  /  グレー破線 = 待機 (通常は空)  /  点線矢印 = 動的起動・退避フロー" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#14442F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1750" width="1900" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>