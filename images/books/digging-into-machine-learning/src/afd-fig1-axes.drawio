<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="「分離」は1つの技術ではない: 3つの直交する分離軸と、それらを貫く1つの横断軸" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1100" height="32" as="geometry"/></mxCell>
<mxCell id="t2" value="上の3行は互いに独立に選べる分離軸(時間・空間・順序)。最下行 EP は分離軸ではなく、どの分離の内側にも現れる FFN 計算の実体(横断軸)。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="20" as="geometry"/></mxCell>
<mxCell id="h0" value="分離軸" style="rounded=0;fillColor=#14532D;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="180" height="52" as="geometry"/></mxCell>
<mxCell id="h1" value="何を分けるか" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="220" y="96" width="250" height="52" as="geometry"/></mxCell>
<mxCell id="h2" value="なぜ分けると効くか(律速の違い)" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="96" width="360" height="52" as="geometry"/></mxCell>
<mxCell id="h3" value="代表技術" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="96" width="310" height="52" as="geometry"/></mxCell>
<mxCell id="a1a" value="&lt;b&gt;軸1 フェーズ分離&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;時間軸&lt;/span&gt;" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=14;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="148" width="180" height="78" as="geometry"/></mxCell>
<mxCell id="a1b" value="Prefill と Decode を別クラスタへ" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="220" y="148" width="250" height="78" as="geometry"/></mxCell>
<mxCell id="a1c" value="Prefill は演算律速、Decode は帯域律速。最適なハード構成・並列度が根本から異なる" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="148" width="360" height="78" as="geometry"/></mxCell>
<mxCell id="a1d" value="&lt;b&gt;P/D Disaggregation&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DistServe / Splitwise / Mooncake&lt;/span&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="148" width="310" height="78" as="geometry"/></mxCell>
<mxCell id="a2a" value="&lt;b&gt;軸2 レイヤ種別分離&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;空間軸&lt;/span&gt;" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=14;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="180" height="78" as="geometry"/></mxCell>
<mxCell id="a2b" value="Attention と FFN/MoE を別 GPU プールへ" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="220" y="226" width="250" height="78" as="geometry"/></mxCell>
<mxCell id="a2c" value="同じ decode の中でも Attention は帯域律速(KV 読み)、FFN/MoE は演算律速。1台に混ぜると片方が遊ぶ" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="226" width="360" height="78" as="geometry"/></mxCell>
<mxCell id="a2d" value="&lt;b&gt;AFD (Attention-FFN Disaggregation)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MegaScale-Infer / Step-3 / FastAFD / vLLM afd-plugin&lt;/span&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="226" width="310" height="78" as="geometry"/></mxCell>
<mxCell id="a3a" value="&lt;b&gt;軸3 Prefill 内スケジューリング&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;順序軸&lt;/span&gt;" style="rounded=0;fillColor=#E8F3EC;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=14;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="304" width="180" height="78" as="geometry"/></mxCell>
<mxCell id="a3b" value="長い prefill と短い prefill の実行順を分ける" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="220" y="304" width="250" height="78" as="geometry"/></mxCell>
<mxCell id="a3c" value="長い prefill が短い要求を待たせる HoL blocking。実行粒度とスケジュール頻度を分離して緩和" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="304" width="360" height="78" as="geometry"/></mxCell>
<mxCell id="a3d" value="&lt;b&gt;FlowPrefill&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;operator-level preemption / event-driven&lt;/span&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="304" width="310" height="78" as="geometry"/></mxCell>
<mxCell id="x1a" value="&lt;b&gt;横断軸 Expert 配置&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;分離軸ではない&lt;/span&gt;" style="rounded=0;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="180" height="88" as="geometry"/></mxCell>
<mxCell id="x1b" value="MoE の expert を複数 GPU へ置き、token を all-to-all で運ぶ" style="rounded=0;fillColor=#B7E1C6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="220" y="392" width="250" height="88" as="geometry"/></mxCell>
<mxCell id="x1c" value="上の3軸が扱う「FFN 計算の実体」そのもの。分離のどの内側にも現れ、prefill は高スループット型、decode は低遅延型と、フェーズで通信モードが変わる" style="rounded=0;fillColor=#B7E1C6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="392" width="360" height="88" as="geometry"/></mxCell>
<mxCell id="x1d" value="&lt;b&gt;Expert Parallelism (EP)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DeepEP / NCCL EP(LL・HT) / Megatron-Core MoE&lt;/span&gt;" style="rounded=0;fillColor=#B7E1C6;strokeColor=#0E3D20;fontColor=#14532D;fontSize=13;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="830" y="392" width="310" height="88" as="geometry"/></mxCell>
<mxCell id="cap" value="読み方: 軸1〜3 は「掛け合わせ」が可能(直交)。EP は縦に貫く。例えば「P/D 分離した decode 側を、さらに AFD で Attention と FFN に分け、その FFN プール内で EP を回す」という入れ子が成立する。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1100" height="40" as="geometry"/></mxCell>
</root></mxGraphModel>