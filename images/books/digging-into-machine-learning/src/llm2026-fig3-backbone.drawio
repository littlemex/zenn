<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b2" value="背骨: 自己回帰デコードの1トークン時間を分解すると, 4トレンドは別々の因子を叩いている" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1040" height="30" as="geometry"/></mxCell><mxCell id="b3" value="小バッチdecodeは演算強度が数FLOPs/byteしかなくルーフラインの左端(帯域律速)に張り付く. だから「1トークンに読むバイト数 ÷ 帯域 ÷ 期待生成トークン数」が支配的. 各因子を下げる4つの独立した打ち手が2026年の設計." style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1040" height="40" as="geometry"/></mxCell><mxCell id="b4" value="1トークンの時間  ≈" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#14532D;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="70" as="geometry"/></mxCell><mxCell id="b5" value="(" style="text;html=1;fontSize=40;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="236" y="144" width="24" height="80" as="geometry"/></mxCell><mxCell id="b6" value="P_active" style="rounded=1;fillColor=#1E7A45;strokeColor=#0E3D20;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="262" y="150" width="96" height="44" as="geometry"/></mxCell><mxCell id="b7" value="・" style="text;html=1;fontSize=24;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="358" y="150" width="20" height="44" as="geometry"/></mxCell><mxCell id="b8" value="b_weight" style="rounded=1;fillColor=#2E9E5B;strokeColor=#14532D;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="378" y="150" width="100" height="44" as="geometry"/></mxCell><mxCell id="b9" value="+" style="text;html=1;fontSize=28;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="28" height="44" as="geometry"/></mxCell><mxCell id="b10" value="L_eff・d_KV" style="rounded=1;fillColor=#5BB97E;strokeColor=#14532D;fontColor=#14532D;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="120" height="44" as="geometry"/></mxCell><mxCell id="b11" value="・" style="text;html=1;fontSize=24;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="150" width="20" height="44" as="geometry"/></mxCell><mxCell id="b12" value="b_KV" style="rounded=1;fillColor=#2E9E5B;strokeColor=#14532D;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="650" y="150" width="74" height="44" as="geometry"/></mxCell><mxCell id="b13" value=")" style="text;html=1;fontSize=40;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="726" y="144" width="24" height="80" as="geometry"/></mxCell><mxCell id="b14" value="" style="line;strokeColor=#14532D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="236" y="202" width="514" height="8" as="geometry"/></mxCell><mxCell id="b15" value="メモリ帯域 BW" style="rounded=1;fillColor=#B7E1C6;strokeColor=#14532D;fontColor=#14532D;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="212" width="160" height="40" as="geometry"/></mxCell><mxCell id="b16" value="÷" style="text;html=1;fontSize=32;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="166" width="30" height="44" as="geometry"/></mxCell><mxCell id="b17" value="τ" style="rounded=1;fillColor=#8FCBA6;strokeColor=#14532D;fontColor=#14532D;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="792" y="158" width="60" height="56" as="geometry"/></mxCell><mxCell id="b18" value="期待生成&lt;br&gt;トークン数" style="text;html=1;fontSize=11;fontColor=#3A6B4A;align=center;" vertex="1" parent="1"><mxGeometry x="856" y="162" width="90" height="40" as="geometry"/></mxCell><mxCell id="b19" value="① MoE" style="rounded=1;fillColor=#1E7A45;strokeColor=#14532D;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=top;html=1;whiteSpace=wrap;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="240" y="300" width="150" height="96" as="geometry"/></mxCell><mxCell id="b20" value="P_active を下げる&lt;br&gt;条件付き計算で&lt;br&gt;active比 3〜7%へ" style="text;html=1;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="246" y="330" width="138" height="60" as="geometry"/></mxCell><mxCell id="b21" style="endArrow=classic;strokeColor=#1E7A45;strokeWidth=2.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="196" as="sourcePoint"/><mxPoint x="315.0" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b22" value="② 低ビット化" style="rounded=1;fillColor=#2E9E5B;strokeColor=#14532D;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=top;html=1;whiteSpace=wrap;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="150" height="96" as="geometry"/></mxCell><mxCell id="b23" value="b_weight, b_KV を下げる&lt;br&gt;FP4/8 native, QAT&lt;br&gt;bit/param を削る" style="text;html=1;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="416" y="330" width="138" height="60" as="geometry"/></mxCell><mxCell id="b24" style="endArrow=classic;strokeColor=#2E9E5B;strokeWidth=2.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="428" y="196" as="sourcePoint"/><mxPoint x="485.0" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b25" value="③ Attention疎化/圧縮" style="rounded=1;fillColor=#5BB97E;strokeColor=#14532D;strokeWidth=2;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=top;html=1;whiteSpace=wrap;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="170" height="96" as="geometry"/></mxCell><mxCell id="b26" value="L_eff・d_KV を下げる&lt;br&gt;MLA/DSA/SWA/線形&lt;br&gt;KV帯域とO(L²)を削る" style="text;html=1;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="586" y="330" width="158" height="60" as="geometry"/></mxCell><mxCell id="b27" style="endArrow=classic;strokeColor=#5BB97E;strokeWidth=2.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="196" as="sourcePoint"/><mxPoint x="665.0" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b28" value="④ MTP / 投機デコード" style="rounded=1;fillColor=#8FCBA6;strokeColor=#14532D;strokeWidth=2;fontColor=#14532D;fontSize=14;fontStyle=1;align=center;verticalAlign=top;html=1;whiteSpace=wrap;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="770" y="300" width="180" height="96" as="geometry"/></mxCell><mxCell id="b29" value="τ で割る&lt;br&gt;1 forwardで複数トークン&lt;br&gt;逐次性(律速)を隠す" style="text;html=1;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="776" y="330" width="168" height="60" as="geometry"/></mxCell><mxCell id="b30" style="endArrow=classic;strokeColor=#8FCBA6;strokeWidth=2.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="196" as="sourcePoint"/><mxPoint x="860.0" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b31" value="要点: 4トレンドは「別々の流派」ではなく, 1本の帯域律速の式を分担して削る同一目標の分業. ただし品質維持の型は分かれる(次図: 定理型=④のみ, 残りは学習時共設計). MoEだけは帯域を下げる一方で総容量とall-to-all通信を増やす=「メモリ節約」ではなく「per-tokenコストと容量の分離」であることに注意." style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1020" height="60" as="geometry"/></mxCell></root></mxGraphModel>