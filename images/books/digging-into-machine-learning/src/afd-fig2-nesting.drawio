<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="時間軸(P/D)と空間軸(AFD)の二重分離: 分離は入れ子にできる" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="縦=フェーズ分離(Prefill / Decode)。横=レイヤ種別分離(Attention / FFN)。AFD は主に decode 行だけを Attention と FFN に再分割する。図中の 2p / 1a / 1f は vLLM afd-plugin の実在レシピ(DeepSeek-V2-Lite)。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1120" height="20" as="geometry"/></mxCell>
<mxCell id="cx1" value="Attention 部(帯域律速・KV を保持)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="92" width="380" height="24" as="geometry"/></mxCell>
<mxCell id="cx2" value="FFN / MoE 部(演算律速・KV 不要)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="92" width="440" height="24" as="geometry"/></mxCell>
<mxCell id="ry1" value="Prefill&#10;(演算律速)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="44" y="120" width="150" height="180" as="geometry"/></mxCell>
<mxCell id="ry2" value="Decode&#10;(帯域律速)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="44" y="312" width="150" height="240" as="geometry"/></mxCell>
<mxCell id="pf" value="&lt;b style=&quot;font-size:15px&quot;&gt;Prefill クラスタ&lt;/b&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Attention と FFN は同一 GPU 上で融合(通常 AFD しない)。大量トークンを一括処理し演算ユニットを埋める。EP は高スループット型(NCCL EP の HT / DeepEP normal)。&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;vLLM recipe: &lt;b&gt;2 プロデューサ(2p)&lt;/b&gt; = NixlConnector kv_producer&lt;/div&gt;" style="rounded=1;fillColor=#E8F3EC;strokeColor=#1E7A45;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;html=1;whiteSpace=wrap;spacing=10;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="940" height="180" as="geometry"/></mxCell>
<mxCell id="kv" value="KV-Cache を転送&#10;(NixlConnector / RDMA)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1E7A45;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="300" width="300" height="24" as="geometry"/></mxCell>
<mxCell id="arrow1" style="endArrow=classic;html=1;strokeColor=#1E7A45;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="300" as="sourcePoint"/><mxPoint x="350" y="326" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="da" value="&lt;b style=&quot;font-size:15px&quot;&gt;Decode: Attention プール&lt;/b&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;KV-Cache を保持し、毎トークン読み直す帯域律速の本体。scheduler・sampling を担う。データ並列でスケール。&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:10px&quot;&gt;vLLM recipe: &lt;b&gt;1 Attention worker(1a)&lt;/b&gt;&lt;br/&gt;= kv_consumer &amp;#43; afd role=attention&lt;/div&gt;" style="rounded=1;fillColor=#B7E1C6;strokeColor=#0E3D20;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;html=1;whiteSpace=wrap;spacing=10;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="440" height="222" as="geometry"/></mxCell>
<mxCell id="df" value="&lt;b style=&quot;font-size:15px&quot;&gt;Decode: FFN / MoE プール&lt;/b&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;expert 計算のみを担う演算律速の本体。&lt;b&gt;KV-Cache を持たない&lt;/b&gt;(NIXL consumer でもない)。この内側で EP が回る。EP は低遅延型(NCCL EP の LL / DeepEP low_latency)。&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:10px&quot;&gt;vLLM recipe: &lt;b&gt;1 FFN worker(1f)&lt;/b&gt; = afd role=ffn&lt;/div&gt;" style="rounded=1;fillColor=#8FCBA6;strokeColor=#0E3D20;strokeWidth=2;fontColor=#14532D;fontSize=12;align=left;verticalAlign=top;html=1;whiteSpace=wrap;spacing=10;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="480" height="222" as="geometry"/></mxCell>
<mxCell id="afd1" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#0E3D20;strokeWidth=3;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="441" as="sourcePoint"/><mxPoint x="660" y="441" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="afdlbl" value="AFD の隠れ状態を N2M / M2N で往復&#10;(N2M: attn→FFN dispatch, M2N: FFN→attn combine)" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#0E3D20;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="556" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="note" value="この decode 行の横分割こそ AFD。P/D 分離(縦)を先に行い、その decode セルを AFD(横)で再分割する二重構造が、vLLM afd-plugin では 2p1a1f として 1 レシピに同居する。ただし検証済みは小規模モデルに限られる(詳細は本文)。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="586" width="940" height="30" as="geometry"/></mxCell>
</root></mxGraphModel>