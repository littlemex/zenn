<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f2" value="層別ビット配分は逆注水: b_l* = const + ½ log2(w_l σ_l²)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1020" height="30" as="geometry"/></mxCell><mxCell id="f3" value="各層を量子化感度 w_l σ_l² の降順に並べる。等歪みの水位線までの深さが割り当てビット b_l。感度が高い層ほど深く=多ビット (FP8)、低い層は浅く=少ビット (FP4)。インセットは確率的丸めの数直線。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="40" as="geometry"/></mxCell><mxCell id="f4" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="620" height="300" as="geometry"/></mxCell><mxCell id="f5" value="" style="rounded=0;fillColor=#DDE5E0;strokeColor=#B8C4BC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="128" y="426" width="62" height="34" as="geometry"/></mxCell><mxCell id="f6" value="" style="rounded=0;fillColor=#2E9E5B;strokeColor=#1E7A45;strokeWidth=1;opacity=90;" vertex="1" parent="1"><mxGeometry x="128" y="244" width="62" height="182" as="geometry"/></mxCell><mxCell id="f7" value="FP8" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="128" y="325" width="62" height="20" as="geometry"/></mxCell><mxCell id="f8" value="L1" style="text;html=1;fontSize=10;fontColor=#3A6B4A;align=center;" vertex="1" parent="1"><mxGeometry x="128" y="464" width="62" height="14" as="geometry"/></mxCell><mxCell id="f9" value="" style="rounded=0;fillColor=#DDE5E0;strokeColor=#B8C4BC;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="206" y="406" width="62" height="54" as="geometry"/><