e="感度 w_l σ_l² (降順) → 床が低い=多ビット" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="482" width="260" height="16" as="geometry"/></mxCell><mxCell id="f40" value="ビット b_l&lt;br&gt;= 水深" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#14532D;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="80" height="40" as="geometry"/></mxCell><mxCell id="f41" value="確率的丸め (SR)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#14532D;align=left;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="280" height="20" as="geometry"/></mxCell><mxCell id="f42" value="" style="rounded=1;fillColor=#F5FBF7;strokeColor=#9CC7AC;" vertex="1" parent="1"><mxGeometry x="780" y="206" width="280" height="150" as="geometry"/></mxCell><mxCell id="f43" style="endArrow=none;strokeColor=#14532D;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="270" as="sourcePoint"/><mxPoint x="1040" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="f44" value="" style="ellipse;fillColor=#1E7A45;strokeColor=#14532D;" vertex="1" parent="1"><mxGeometry x="825" y="265" width="10" height="10" as="geometry"/></mxCell><mxCell id="f45" value="⌊x/Δ⌋Δ" style="text;html=1;fontSize=10;fontColor=#3A6B4A;align=center;" vertex="1" parent="1"><mxGeometry x="785" y="280" width="90" height="14" as="geometry"/></mxCell><mxCell id="f46" value="" style="ellipse;fillColor=#1E7A45;strokeColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1005" y="265" width="10" height="10" as="geometry"/></mxCell><mxCell id="f47" value="(⌊x/Δ⌋+1)Δ" style="text;html=1;fontSize=10;fontColor=#3A6B4A;align=center;" vertex="1" parent="1"><mxGeometry x="965" y="280" width="90" height="14" as="geometry"/></mxCell><mxCell id="f48" value="" style="rounded=0;fillColor=#B44;strokeColor=#B44;" vertex="1" parent="1"><mxGeometry x="940" y="256" width="4" height="28" as="geometry"/></mxCell><mxCell id="f49" value