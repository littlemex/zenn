style="ellipse;fillColor=#E8A33D;strokeColor=#B45309;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="207.7" y="596.9" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="r62" value="BF16" style="text;html=1;fontSize=9;fontStyle=1;fontColor=#B45309;align=left;" vertex="1" parent="1"><mxGeometry x="215.7" y="594.9" width="34.0" height="12.0" as="geometry"/></mxCell><mxCell id="r63" value="" style="ellipse;fillColor=#E8A33D;strokeColor=#B45309;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="269.4" y="557.7" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="r64" value="FP8" style="text;html=1;fontSize=9;fontStyle=1;fontColor=#B45309;align=left;" vertex="1" parent="1"><mxGeometry x="277.4" y="555.7" width="34.0" height="12.0" as="geometry"/></mxCell><mxCell id="r65" value="" style="ellipse;fillColor=#E8A33D;strokeColor=#B45309;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="331.1" y="518.6" width="8.0" height="8.0" as="geometry"/></mxCell><mxCell id="r66" value="FP4" style="text;html=1;fontSize=9;fontStyle=1;fontColor=#B45309;align=left;" vertex="1" parent="1"><mxGeometry x="339.1" y="516.6" width="34.0" height="12.0" as="geometry"/></mxCell><mxCell id="r67" style="endArrow=classic;strokeColor=#7A9A85;strokeWidth=1.5;dashed=1;dashPattern=3 3;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335.1" y="522.6" as="sourcePoint"/><mxPoint x="643.6" y="326.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r68" value="batch 積み増しで右へ&lt;br&gt;(B=128でも AI≒128, ridge 591 に届かず)" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#5C7A67;align=left;" vertex="1" parent="1"><mxGeometry x="478.4" y="296.9" width="250.0" height="28.0" as="geometry"/></mxCell><mxCell id="r69" value="← 帯域律速 (memory-bound)" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#3A6B4A;align=center;" vertex="1" parent="1"><mxGeometry x="309.5" y="602.0" width="200.0" height="16.0" as="geometry"/></mxCell><mxCell id="r70" value="演算律速 (compute-bound) →" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#3A6B4A;align=center;" vertex="1" parent="1"><mxGeometry x="788.2" y="602.0" width="200.0" height="16.0" as="geometry"/></mxCell><mxCell id="r71" value="読み筋: (1) decode の演算強度は精度で決まり FP4 native で 1→4 FLOP/Byte に上がる = 同じ帯域でも到達性能が上がる. (2) だが ridge point も 153→1250 と右へ動く = compute-bound には依然届かず, decode は帯域律速のまま. (3) だから「1トークンに読むバイト数」を削る 4 トレンド(MoE=P_active↓, 低ビット=b↓, Attn疎化=KVバイト↓, MTP=読み回数を割る)が効く. 背景は AI Memory Wall (arXiv:2403.14123)." style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="682.0" width="1060.0" height="66.0" as="geometry"/></mxCell></root></mxGraphModel>