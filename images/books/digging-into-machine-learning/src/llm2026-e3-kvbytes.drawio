<mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="KV バイトの解剖: どの因子を叩くかで3系統が分かれる" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#14532D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1020" height="30" as="geometry"/></mxCell><mxCell id="c3" value="1リクエストの KV-Cache バイト数を因子分解し、各手法がどの因子を縮めるかを対応づける。線形化だけは式ごと固定サイズの状態へ置き換える。" style="text;html=1;fontSize=12;fontColor=#3A6B4A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1020" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Bytes_KV  ≈" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#14532D;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="150" height="50" as="geometry"/></mxCell><mxCell id="c5" value="2" style="rounded=1;fillColor=#DDEDE3;strokeColor=#14532D;fontColor=#14532D;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="40" height="50" as="geometry"/></mxCell><mxCell id="c6" value="·" style="text;html=1;fontSize=24;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="244" y="150" width="20" height="50" as="geometry"/></mxCell><mxCell id="c7" value="n_layer" style="rounded=1;fillColor=#DDEDE3;strokeColor=#14532D;fontColor=#14532D;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;html=1;" vertex="1" parent="1"><mxGeometry x="268" y="150" width="90" height="50" as="geometry"/></mxCell><mxCell id="c8" value="·" style="text;html=1;fontSize=24;fontColor=#14532D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="362" y="150" width="20" height="50" as="geometry"/></mxCell><mxCell id="c9" value="n_kv" style="rounded=1;fi