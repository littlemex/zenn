lor=#8FCBA6;strokeWidth=2.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="200" as="sourcePoint"/><mxPoint x="600" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="線形化 (Mamba/DeltaNet)" style="rounded=1;fillColor=#2E9E5B;strokeColor=#14532D;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;html=1;whiteSpace=wrap;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="710" y="320" width="200" height="110" as="geometry"/></mxCell><mxCell id="c26" value="式全体 → 固定状態&lt;br&gt;d_k×d_v の再帰へ置換&lt;br&gt;系列長に依存しない" style="text;html=1;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="716" y="348" width="188" height="76" as="geometry"/></mxCell><mxCell id="c27" style="endArrow=classic;strokeColor=#2E9E5B;strokeWidth=2.5;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="735" y="200" as="sourcePoint"/><mxPoint x="810" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="KV 量子化 (b_KV を下げる) は要素4で扱う。この図は「KV 項の内部分解」であり、第1章の背骨式図 (式全体の因子分担) とは機能が異なる。" style="rounded=1;fillColor=#F5FBF7;strokeColor=#2E9E5B;strokeWidth=1.5;fontColor=#14532D;fontSize=12;align=left;verticalAlign=middle;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1020" height="44" as="geometry"/></mxCell></root></mxGraphModel>